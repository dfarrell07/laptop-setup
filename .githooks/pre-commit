#!/bin/bash
# Pre-commit checks: vault encryption, secrets, YAML, shell, JSON
failed=0

# Block unencrypted vault files
while IFS= read -r -d '' f; do
  if ! _vault_content=$(git show ":$f" 2>/dev/null); then
    echo "WARNING: could not read staged $f — skipping vault check" >&2
    continue
  fi
  if ! printf '%s' "$_vault_content" | head -1 | grep -q '^\$ANSIBLE_VAULT'; then
    # Allow plaintext stub: vault_placeholder present and all other vault_* vars are empty stubs ([] only)
    if printf '%s' "$_vault_content" | grep -q 'vault_placeholder' && \
       [ "$(printf '%s' "$_vault_content" | grep -E '^vault_' | grep -Ev 'vault_placeholder|:[[:space:]]*\[\]' | wc -l)" -eq 0 ]; then
      echo "NOTE: $f is a plaintext stub (no real secrets) — OK" >&2
      continue
    fi
    echo "ERROR: $f is not encrypted. Run: ansible-vault encrypt $f" >&2
    failed=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*vault.yml')

# Secret scanning
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks_args=()
  [ -f .gitleaks.toml ] && gitleaks_args+=(--config .gitleaks.toml)
  gitleaks git --pre-commit --staged --redact --max-decode-depth 2 "${gitleaks_args[@]}"
  _gitleaks_rc=$?
  if [ "$_gitleaks_rc" -ne 0 ]; then
    failed=1
  fi
else
  echo "WARNING: gitleaks not found — secret scanning skipped (run 'make all' to install)" >&2
fi

# YAML lint staged files
YAMLLINT=""
if command -v yamllint >/dev/null 2>&1; then
  YAMLLINT=yamllint
elif [ -x ".venv/bin/yamllint" ]; then
  YAMLLINT=".venv/bin/yamllint"
fi
if [ -n "$YAMLLINT" ]; then
  while IFS= read -r -d '' f; do
    _yl_content=$(git show ":$f") || { echo "WARNING: could not read staged $f — skipping YAML lint" >&2; continue; }
    printf '%s\n' "$_yl_content" | "$YAMLLINT" --strict -f parsable - 2>&1 | awk -v fn="$f" 'sub(/^stdin:/, fn":")||1'
    # PIPESTATUS indices: [0]=printf [1]=yamllint [2]=awk — update index if pipe structure changes
    _yl_rc=${PIPESTATUS[1]}
    [ "$_yl_rc" -ne 0 ] && failed=1
  done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.yml' '*.yaml' | grep -zEv '(^|/)[^/]*vault\.yml$' | grep -zEv '^(collections|node_modules|\.venv)/') # collections/, node_modules/, .venv/ excluded: stdin-mode yamllint ignores the 'ignore:' config; exclude to match .yamllint + make lint behaviour
else
  echo "WARNING: yamllint not found — YAML lint skipped (run 'make lint' to install)" >&2
fi

# Shell lint staged scripts
if command -v shellcheck >/dev/null 2>&1; then
  sh_files=()
  while IFS= read -r -d '' _f; do sh_files+=("$_f"); done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.sh' '.githooks/*' 'roles/dotfiles/files/git-template-*')
  if (( ${#sh_files[@]} > 0 )); then
    for _f in "${sh_files[@]}"; do
      _sc_content=$(git show ":$_f") || { echo "WARNING: could not read staged $_f — skipping shellcheck" >&2; continue; }
      printf '%s' "$_sc_content" | shellcheck --filename="$_f" -S warning - || failed=1
    done
  fi
else
  echo "WARNING: shellcheck not found — shell lint skipped (run 'make bootstrap' to install)" >&2
fi

# JSON validation on staged files
if ! command -v python3 >/dev/null 2>&1; then
  echo "WARNING: python3 not found — JSON/lockfile validation skipped" >&2
else
  while IFS= read -r -d '' f; do
    if ! git show ":$f" | python3 -m json.tool > /dev/null; then
      echo "ERROR: $f is not valid JSON" >&2
      failed=1
    fi
  done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.json' | grep -z -v '^package-lock\.json$')

  # Guard against future supply-chain drift: all current packages use sha512 + registry.npmjs.org
  # Lockfile integrity (only when package-lock.json is staged)
  # Only checks repo-root package-lock.json; subdirectory lockfiles would need separate handling
  if git diff --cached --name-only -z --diff-filter=ACMR | grep -qz '^package-lock\.json$'; then
    if ! git show :package-lock.json | python3 -c "
import json, sys
try:
    lock = json.load(sys.stdin)
except json.JSONDecodeError as e:
    print(f'ERROR: package-lock.json is not valid JSON: {e}', file=sys.stderr)
    sys.exit(1)
errors = []
for name, info in lock.get('packages', {}).items():
    if not name:
        continue
    integrity = info.get('integrity', '')
    resolved = info.get('resolved', '')
    if resolved.startswith('https://registry.npmjs.org/') and not integrity:
        errors.append(f'ERROR: Missing integrity in lockfile: {name}')
    if integrity and not integrity.startswith('sha512-'):
        errors.append(f'ERROR: Weak hash in lockfile: {name}')
    if resolved and not (resolved.startswith('https://registry.npmjs.org/') or resolved.startswith('file:')):
        errors.append(f'ERROR: Non-npmjs registry in lockfile: {name} -> {resolved}')
if errors:
    print('\n'.join(errors), file=sys.stderr)
    sys.exit(1)
" 2>&1; then
      failed=1
    fi
  fi
fi

exit $failed
