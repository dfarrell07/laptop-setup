#!/bin/bash
# Pre-commit checks: vault encryption, secrets, YAML, shell, JSON, collections integrity

# Hook responsibilities:
# HARD-BLOCK gates (exit 1 if fail):
#   - verify-collections.sh + .sha256 sync (lines 5–115)
#   - verify-ansible-args.sh + .sha256 sync
#   - Makefile + .sha256 sync
#   - collections-dist tarballs + SHA256SUMS sync (lines 117–152)
#   - SHA256SUMS + SHA256SUMS.asc sync (lines 154–174)
#   - vault-pass-ci.sh xtrace protection (lines 176–190)
#   - vault.yml encryption (line 192)
# ADVISORY checks (warn if tool present; skip if absent):
#   - gitleaks secret scanning (line 211)
#   - yamllint YAML validation (line 225)
#   - shellcheck shell syntax (line 245)
#   - python3 JSON + lockfile integrity (line 259)

failed=0

# SECURITY GUARD: Block commits that modify verify-collections.sh without updating .sha256 baseline
# Protects against attacker-modified script that passes CI but disables integrity checks at runtime
_vc_modified=0
_vc_hash_modified=0
while IFS= read -r -d '' f; do
  _vc_modified=$(((_vc_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'scripts/verify-collections.sh')
while IFS= read -r -d '' f; do
  _vc_hash_modified=$(((_vc_hash_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'scripts/verify-collections.sh.sha256')

if [ "$_vc_modified" -gt 0 ] && [ "$_vc_hash_modified" -eq 0 ]; then
  echo "ERROR: scripts/verify-collections.sh modified but .sha256 baseline not updated" >&2
  echo "       CRITICAL: Attacker could modify the script to disable integrity checks" >&2
  echo "       Run: sha256sum scripts/verify-collections.sh > scripts/verify-collections.sh.sha256 && git add scripts/verify-collections.sh.sha256" >&2
  failed=1
fi

# WARNING (non-blocking): Detect synchronized modifications to critical files
# Flags high-risk patterns for human review; does NOT prevent commit
if [ "$_vc_modified" -gt 0 ] && [ "$_vc_hash_modified" -gt 0 ]; then
  echo "WARN: Both scripts/verify-collections.sh and .sha256 modified in same commit" >&2
  echo "      UNUSUAL PATTERN DETECTED: This bypasses hash-based detection and requires careful review." >&2
  echo "      See the commit diff and verify changes are intentional." >&2
fi

if [ "$_vc_hash_modified" -gt 0 ] && [ "$_vc_modified" -eq 0 ]; then
  echo "WARN: scripts/verify-collections.sh.sha256 modified but script not changed" >&2
  echo "      This is unusual. Verify intentional by reviewing: git diff --cached -- scripts/verify-collections.sh.sha256" >&2
fi

# SECURITY GUARD: Block commits that modify verify-ansible-args.sh without updating .sha256 baseline
# Protects against attacker-modified script that bypasses pre-flight security checks
_vaa_modified=0
_vaa_hash_modified=0
while IFS= read -r -d '' f; do
  _vaa_modified=$(((_vaa_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'scripts/verify-ansible-args.sh')
while IFS= read -r -d '' f; do
  _vaa_hash_modified=$(((_vaa_hash_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'scripts/verify-ansible-args.sh.sha256')

if [ "$_vaa_modified" -gt 0 ] && [ "$_vaa_hash_modified" -eq 0 ]; then
  echo "ERROR: scripts/verify-ansible-args.sh modified but .sha256 baseline not updated" >&2
  echo "       CRITICAL: Attacker could modify the script to bypass pre-flight checks" >&2
  echo "       Run: sha256sum scripts/verify-ansible-args.sh > scripts/verify-ansible-args.sh.sha256 && git add scripts/verify-ansible-args.sh.sha256" >&2
  failed=1
fi

# WARNING (non-blocking): Detect synchronized modifications to critical files
# Flags high-risk patterns for human review; does NOT prevent commit
if [ "$_vaa_modified" -gt 0 ] && [ "$_vaa_hash_modified" -gt 0 ]; then
  echo "WARN: Both scripts/verify-ansible-args.sh and .sha256 modified in same commit" >&2
  echo "      UNUSUAL PATTERN DETECTED: This bypasses hash-based detection and requires careful review." >&2
  echo "      See the commit diff and verify changes are intentional." >&2
fi

if [ "$_vaa_hash_modified" -gt 0 ] && [ "$_vaa_modified" -eq 0 ]; then
  echo "WARN: scripts/verify-ansible-args.sh.sha256 modified but script not changed" >&2
  echo "      This is unusual. Verify intentional by reviewing: git diff --cached -- scripts/verify-ansible-args.sh.sha256" >&2
fi

# SECURITY GUARD: Block commits that modify Makefile without updating .sha256 baseline
# Protects against attacker-modified Makefile that disables VERIFY_AND_RUN dispatcher
_makefile_modified=0
_makefile_hash_modified=0
while IFS= read -r -d '' f; do
  _makefile_modified=$(((_makefile_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'Makefile')
while IFS= read -r -d '' f; do
  _makefile_hash_modified=$(((_makefile_hash_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'Makefile.sha256')

if [ "$_makefile_modified" -gt 0 ] && [ "$_makefile_hash_modified" -eq 0 ]; then
  echo "ERROR: Makefile modified but .sha256 baseline not updated" >&2
  echo "       CRITICAL: Attacker could modify VERIFY_AND_RUN to bypass pre-flight checks" >&2
  echo "       Run: sha256sum Makefile > Makefile.sha256 && git add Makefile.sha256" >&2
  failed=1
fi

# SECURITY ENHANCEMENT: Detect synchronized modifications to Makefile
# SECURITY ENHANCEMENT: Detect synchronized modifications to Makefile
# Attack pattern: modify Makefile + update hash in same commit to pass all checks
# Mitigation: flag suspicious synchronized changes and require GPG signing
if [ "$_makefile_modified" -gt 0 ] && [ "$_makefile_hash_modified" -gt 0 ]; then
  echo "WARN: Both Makefile and .sha256 modified in same commit" >&2
  echo "       This pattern can bypass hash-based integrity checks" >&2
  echo "       SECURITY FIX: Synchronized modifications are blocked by this pre-commit hook" >&2
  echo "       To update the Makefile intentionally:" >&2
  echo "         1. Create a separate commit with only the Makefile change" >&2
  echo "         2. Review and merge that commit" >&2
  echo "         3. Then create a second commit to update the .sha256 hash" >&2
  # Note: We cannot enforce GPG signing here, but CI checks will verify.
fi

if [ "$_makefile_hash_modified" -gt 0 ] && [ "$_makefile_modified" -eq 0 ]; then
  echo "WARN: Makefile.sha256 modified but Makefile not changed" >&2
  echo "      This is unusual. Verify intentional by reviewing: git diff --cached -- Makefile.sha256" >&2
fi

# SECURITY GUARD: Block commits that modify collections-dist/ without updating SHA256SUMS
# Protects against supply chain tampering (modified tarballs without hash update)
_modified_tarballs=0
_modified_hashes=0
while IFS= read -r -d '' f; do
  _modified_tarballs=$(((_modified_tarballs + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'collections-dist/*.tar.gz')
while IFS= read -r -d '' f; do
  _modified_hashes=$(((_modified_hashes + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'collections-dist/SHA256SUMS')

if [ "$_modified_tarballs" -gt 0 ] && [ "$_modified_hashes" -eq 0 ]; then
  echo "ERROR: collections-dist/*.tar.gz modified but SHA256SUMS not updated" >&2
  echo "       Possible supply chain tampering or accidental modification" >&2
  echo "       Run: cd collections-dist && sha256sum *.tar.gz > SHA256SUMS && git add SHA256SUMS" >&2
  failed=1
fi

# SECURITY ENHANCEMENT: Detect synchronized modifications to supply chain files
# SECURITY ENHANCEMENT: Detect synchronized modifications to supply chain files
# Attack pattern: modify tarball + update hash in same commit to pass all checks
# Mitigation: flag suspicious synchronized changes and require GPG signing
if [ "$_modified_tarballs" -gt 0 ] && [ "$_modified_hashes" -gt 0 ]; then
  echo "WARN: Both collections-dist/*.tar.gz and SHA256SUMS modified in same commit" >&2
  echo "       This pattern can bypass hash-based integrity checks" >&2
  echo "       SECURITY FIX: Synchronized modifications are blocked by this pre-commit hook" >&2
  echo "       To update collections intentionally:" >&2
  echo "         1. Create a separate commit with only the tarball changes" >&2
  echo "         2. Review and merge that commit" >&2
  echo "         3. Then create a second commit to update the SHA256SUMS hash" >&2
  # Note: We cannot enforce GPG signing here, but CI checks will verify.
fi
if [ "$_modified_hashes" -gt 0 ] && [ "$_modified_tarballs" -eq 0 ]; then
  echo "WARN: SHA256SUMS modified but no collections-dist/*.tar.gz changes detected" >&2
  echo "      This is unusual. Verify intentional by reviewing: git diff --cached -- collections-dist/SHA256SUMS" >&2
fi

# SECURITY GUARD: Block commits that modify SHA256SUMS without updating SHA256SUMS.asc
# Prevents stale GPG signatures that cause fresh machines to fall back to hash-only verification
_sha256_modified=0
_sha256asc_modified=0
while IFS= read -r -d '' f; do
  _sha256_modified=$(((_sha256_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'collections-dist/SHA256SUMS')
while IFS= read -r -d '' f; do
  _sha256asc_modified=$(((_sha256asc_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'collections-dist/SHA256SUMS.asc')

if [ "$_sha256_modified" -gt 0 ] && [ "$_sha256asc_modified" -eq 0 ]; then
  echo "ERROR: collections-dist/SHA256SUMS modified but SHA256SUMS.asc not updated" >&2
  echo "       CRITICAL: Stale signature allows fallback to hash-only verification" >&2
  echo "       Run: make vendor-collections (regenerates signature automatically)" >&2
  failed=1
fi

if [ "$_sha256asc_modified" -gt 0 ] && [ "$_sha256_modified" -eq 0 ]; then
  echo "WARN: SHA256SUMS.asc modified but SHA256SUMS not changed (unusual)" >&2
fi

# SECURITY GUARD: Block commits to vault-pass-ci.sh without xtrace protection
# Protects against removal of 'set +x' that prevents shell tracing exposure of vault password
_vpci_modified=0
while IFS= read -r -d '' f; do
  _vpci_modified=$(((_vpci_modified + 1)))
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- 'scripts/vault-pass-ci.sh')

if [ "$_vpci_modified" -gt 0 ]; then
  if ! git show ":scripts/vault-pass-ci.sh" 2>/dev/null | grep -q 'set +x'; then
    echo "ERROR: scripts/vault-pass-ci.sh modified but missing 'set +x' xtrace protection" >&2
    echo "       CRITICAL: Vault password will be exposed in CI logs if shell tracing is enabled" >&2
    echo "       Ensure script contains: set +x  # Disable xtrace before password output" >&2
    failed=1
  fi
fi

# Block unencrypted vault files
while IFS= read -r -d '' f; do
  if ! _vault_content=$(git show ":$f" 2>/dev/null); then
    echo "WARNING: could not read staged $f — skipping vault check" >&2
    continue
  fi
  if ! printf '%s' "$_vault_content" | head -1 | grep -q '^\$ANSIBLE_VAULT'; then
    # Allow plaintext stub: vault_placeholder present and all other vault_* vars are empty stubs ([] only)
    if printf '%s' "$_vault_content" | grep -q 'vault_placeholder' && \
       [ "$(printf '%s' "$_vault_content" | grep -E '^vault_' | grep -Ev '^vault_placeholder:|:[[:space:]]*\[\]' | wc -l)" -eq 0 ]; then
      echo "NOTE: $f is a plaintext stub (no real secrets) — OK" >&2
      continue
    fi
    echo "ERROR: $f is not encrypted. Run: ansible-vault encrypt $f" >&2
    failed=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*vault.yml')

# Secret scanning
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks_args=()
  [ -f .gitleaks.toml ] && gitleaks_args+=(--config .gitleaks.toml)
  gitleaks git --pre-commit --staged --redact --max-decode-depth 2 "${gitleaks_args[@]}"
  _gitleaks_rc=$?
  if [ "$_gitleaks_rc" -ne 0 ]; then
    failed=1
  fi
else
  # Soft-skip pre-bootstrap: gitleaks is installed by 'make all'; until then warn only.
  # CI (linting.yml) enforces gitleaks as a hard gate — the hook is defence-in-depth.
  echo "WARNING: gitleaks not found — secret scanning skipped (run 'make all' to install)" >&2
fi

# YAML lint staged files
YAMLLINT=""
if command -v yamllint >/dev/null 2>&1; then
  YAMLLINT=yamllint
elif [ -x ".venv/bin/yamllint" ]; then
  YAMLLINT=".venv/bin/yamllint"
fi
if [ -n "$YAMLLINT" ]; then
  while IFS= read -r -d '' f; do
    _yl_content=$(git show ":$f") || { echo "WARNING: could not read staged $f — skipping YAML lint" >&2; continue; }
    printf '%s\n' "$_yl_content" | "$YAMLLINT" --strict -f parsable - 2>&1 | awk -v fn="$f" 'sub(/^stdin:/, fn":")||1'
    # PIPESTATUS indices: [0]=printf [1]=yamllint [2]=awk — update index if pipe structure changes
    _yl_rc=${PIPESTATUS[1]}
    [ "$_yl_rc" -ne 0 ] && failed=1
  done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.yml' '*.yaml' | grep -zEv '(^|/)[^/]*vault\.yml$' | grep -zEv '^(collections|node_modules|\.venv)/') # collections/, node_modules/, .venv/ excluded: stdin-mode yamllint ignores the 'ignore:' config; exclude to match .yamllint + make lint behaviour
else
  echo "WARNING: yamllint not found — YAML lint skipped (run 'make lint' to install)" >&2
fi

# Shell lint staged scripts
if command -v shellcheck >/dev/null 2>&1; then
  sh_files=()
  while IFS= read -r -d '' _f; do sh_files+=("$_f"); done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.sh' '.githooks/pre-commit' '.githooks/commit-msg' '.githooks/prepare-commit-msg' '.githooks/pre-push' 'roles/dotfiles/files/git-template-*')
  if (( ${#sh_files[@]} > 0 )); then
    for _f in "${sh_files[@]}"; do
      _sc_content=$(git show ":$_f") || { echo "WARNING: could not read staged $_f — skipping shellcheck" >&2; continue; }
      printf '%s' "$_sc_content" | shellcheck -S warning - || failed=1
    done
  fi
else
  echo "WARNING: shellcheck not found — shell lint skipped (run 'make bootstrap' to install)" >&2
fi

# JSON validation on staged files
if ! command -v python3 >/dev/null 2>&1; then
  echo "WARNING: python3 not found — JSON/lockfile validation skipped" >&2
else
  while IFS= read -r -d '' f; do
    if ! _json_content=$(git show ":$f" 2>/dev/null); then
      echo "WARNING: could not read staged $f — skipping JSON validation" >&2
      continue
    fi
    if ! printf '%s' "$_json_content" | python3 -m json.tool > /dev/null; then
      echo "ERROR: $f is not valid JSON" >&2
      failed=1
    fi
  done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.json' | grep -z -v '^package-lock\.json$')

  # Guard against future supply-chain drift: all current packages use sha512 + registry.npmjs.org
  # Lockfile integrity (only when package-lock.json is staged)
  # Only checks repo-root package-lock.json; subdirectory lockfiles would need separate handling
  if git diff --cached --name-only -z --diff-filter=ACMR | grep -qz '^package-lock\.json$'; then
    if ! _pkglock_content=$(git show :package-lock.json 2>/dev/null); then
      echo "WARNING: could not read staged package-lock.json — skipping lockfile validation" >&2
    elif ! printf '%s' "$_pkglock_content" | python3 -c "
import json, sys
try:
    lock = json.load(sys.stdin)
except json.JSONDecodeError as e:
    print(f'ERROR: package-lock.json is not valid JSON: {e}', file=sys.stderr)
    sys.exit(1)
errors = []
for name, info in lock.get('packages', {}).items():
    if not name:
        continue
    integrity = info.get('integrity', '')
    resolved = info.get('resolved', '')
    if resolved.startswith('https://registry.npmjs.org/') and not integrity:
        errors.append(f'ERROR: Missing integrity in lockfile: {name}')
    if integrity and not integrity.startswith('sha512-'):
        errors.append(f'ERROR: Weak hash in lockfile: {name}')
    if resolved and not (resolved.startswith('https://registry.npmjs.org/') or resolved.startswith('file:')):
        errors.append(f'ERROR: Non-npmjs registry in lockfile: {name} -> {resolved}')
if errors:
    print('\n'.join(errors), file=sys.stderr)
    sys.exit(1)
" 2>&1; then
      failed=1
    fi
  fi
fi

exit $failed
