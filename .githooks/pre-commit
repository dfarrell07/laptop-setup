#!/bin/bash
# Pre-commit checks: vault encryption, secrets, YAML, shell, JSON
failed=0

# Block unencrypted vault files
for f in $(git diff --cached --name-only --diff-filter=ACM -z -- '*vault.yml' | tr '\0' '\n'); do
  if ! git show ":$f" | head -1 | grep -q '^\$ANSIBLE_VAULT'; then
    # Allow plaintext stub: vault_placeholder present and all other vault_* vars are empty stubs ([] only)
    if git show ":$f" | grep -q 'vault_placeholder' && \
       [ "$(git show ":$f" | grep -E '^vault_' | grep -Ev 'vault_placeholder|:[[:space:]]*\[\]' | wc -l)" -eq 0 ]; then
      echo "NOTE: $f is a plaintext stub (no real secrets) — OK" >&2
      continue
    fi
    echo "ERROR: $f is not encrypted. Run: ansible-vault encrypt $f" >&2
    failed=1
  fi
done

# Secret scanning
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --redact --max-decode-depth 2 --config .gitleaks.toml; then
    failed=1
  fi
else
  echo "WARNING: gitleaks not found — secret scanning skipped (run 'make all' to install)" >&2
fi

# YAML lint staged files
YAMLLINT=""
if command -v yamllint >/dev/null 2>&1; then
  YAMLLINT=yamllint
elif [ -x ".venv/bin/yamllint" ]; then
  YAMLLINT=".venv/bin/yamllint"
fi
if [ -n "$YAMLLINT" ]; then
  yaml_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.yml' '*.yaml' | grep -v node_modules | grep -v collections)
  if [ -n "$yaml_files" ]; then
    if ! echo "$yaml_files" | xargs "$YAMLLINT" --strict; then
      failed=1
    fi
  fi
else
  echo "WARNING: yamllint not found — YAML lint skipped (run 'make lint' to install)" >&2
fi

# Shell lint staged scripts
if command -v shellcheck >/dev/null 2>&1; then
  sh_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.sh')
  if [ -n "$sh_files" ]; then
    if ! echo "$sh_files" | xargs shellcheck -S warning; then
      failed=1
    fi
  fi
fi

# JSON validation on staged files
while IFS= read -r -d '' f; do
  if ! python3 -m json.tool "$f" > /dev/null 2>&1; then
    echo "ERROR: $f is not valid JSON" >&2
    failed=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.json' | grep -z -v node_modules | grep -z -v package-lock)

# Lockfile integrity (only when package-lock.json is staged)
if git diff --cached --name-only | grep -q 'package-lock.json'; then
  if ! python3 -c "
import json, sys
lock = json.load(open('package-lock.json'))
for name, info in lock.get('packages', {}).items():
    if not name:
        continue
    integrity = info.get('integrity', '')
    resolved = info.get('resolved', '')
    if integrity and not integrity.startswith('sha512-'):
        print(f'ERROR: Weak hash in lockfile: {name}', file=sys.stderr)
        sys.exit(1)
    if resolved and not resolved.startswith('https://registry.npmjs.org/'):
        print(f'ERROR: Non-npmjs registry in lockfile: {name} -> {resolved}', file=sys.stderr)
        sys.exit(1)
    if resolved.startswith(('git://', 'git+', 'ssh://')):
        print(f'ERROR: Git protocol dep bypasses ignore-scripts: {name}', file=sys.stderr)
        sys.exit(1)
" 2>&1; then
    failed=1
  fi
fi

exit $failed
