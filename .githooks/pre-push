#!/bin/bash
# Pre-push hook: enforce vault encryption, Signed-off-by, supply-chain GPG signing, and gitleaks
# SECURITY: Blocks push if:
#   1. Any vault.yml file is unencrypted (secrets exposure prevention)
#   2. Any commit lacks Signed-off-by trailer (supply-chain validation)
#   3. Critical supply-chain files modified without GPG signature (tampering prevention)
#   4. Secrets detected by gitleaks (credentials leakage prevention)
# DEFENSE-IN-DEPTH: This hook can be bypassed via core.hooksPath override. GitHub Actions provides secondary protection.
# Together they provide multi-layer defense against supply-chain attacks and secrets leakage.

set -euo pipefail

failed=0

# SECURITY: Verify hooks are enabled and not bypassed via core.hooksPath override
# Attack: git config --local core.hooksPath /dev/null (or any other path) disables this entire hook
# Detection: Compare current config against expected value; fatal error if overridden
current_hookspath=$(git config --local core.hooksPath 2>/dev/null || true)
if [ -n "$current_hookspath" ] && [ "$current_hookspath" != ".githooks" ]; then
  echo "CRITICAL SECURITY ERROR: core.hooksPath override detected" >&2
  echo "  Current setting: core.hooksPath = $current_hookspath" >&2
  echo "  Expected:       core.hooksPath = .githooks (or unset)" >&2
  echo "" >&2
  echo "This override disables pre-push vault checks." >&2
  echo "An attacker may have modified .git/config to bypass hook enforcement." >&2
  echo "" >&2
  echo "FIX: Restore core.hooksPath to .githooks or unset it:" >&2
  echo "  git config --local --unset core.hooksPath" >&2
  echo "Then restart the push." >&2
  echo "" >&2
  echo "Note: GitHub Actions will also catch and reject any pushed commits" >&2
  echo "      if vault.yml is unencrypted, providing secondary protection." >&2
  exit 1
fi

# Iterate through vault files in the push
while IFS= read -r -d '' f; do
  if [ ! -f "$f" ]; then
    continue
  fi

  # Check if file starts with $ANSIBLE_VAULT (encrypted marker)
  if ! head -1 "$f" | grep -q '^\$ANSIBLE_VAULT'; then
    # Allow plaintext stub (no real secrets): vault_placeholder marker + empty vault_* stubs
    # Rationale: Initial setup requires a plaintext stub file before encryption (chicken-egg problem).
    # Once any real secrets are added, encryption becomes mandatory.
    # Stub format: contains vault_placeholder comment AND all vault_* variables are either:
    #   1. vault_placeholder references, OR
    #   2. empty stubs (: [])
    if grep -q 'vault_placeholder' "$f" && \
       [ "$(grep -E '^vault_' "$f" | grep -Ev '^vault_placeholder:|:[[:space:]]*\[\]' | wc -l)" -eq 0 ]; then
      echo "NOTE: $f is a plaintext stub (vault_placeholder marker + empty stubs) — OK" >&2
      continue
    fi
    echo "ERROR: $f is not encrypted. Run: ansible-vault encrypt $f" >&2
    echo "ERROR: Unencrypted vault files cannot be pushed to prevent secrets exposure." >&2
    failed=1
  else
    # File has vault marker on line 1; validate actual encryption by attempting decryption
    # This prevents marker spoofing (plaintext file with forged $ANSIBLE_VAULT prefix).
    # Attack: Attacker writes plaintext secrets with $ANSIBLE_VAULT;1.1;AES256 prefix to bypass this check.
    # Defense: Require actual decryption success (not just format validation).
    vault_pass_file=""
    if [ -f "vault-pass.sh" ]; then
      vault_pass_file="vault-pass.sh"
    elif [ -f "scripts/vault-pass-ci.sh" ]; then
      # Fallback to CI stub (e.g., in CI environments where vault-pass.sh is gitignored)
      vault_pass_file="scripts/vault-pass-ci.sh"
    fi

    if [ -n "$vault_pass_file" ]; then
      if ! ansible-vault view --vault-password-file="$vault_pass_file" "$f" >/dev/null 2>&1; then
        echo "ERROR: $f has vault marker but is not validly encrypted or password is incorrect." >&2
        echo "ERROR: Run: ansible-vault encrypt $f" >&2
        failed=1
      fi
    else
      # vault-pass.sh and vault-pass-ci.sh both missing: cannot validate decryption, fail-fast
      echo "ERROR: $f has vault marker but vault-pass.sh/scripts/vault-pass-ci.sh is missing." >&2
      echo "ERROR: Cannot validate encryption without password provider. Run: ansible-vault view $f" >&2
      echo "ERROR: (Requires vault-pass.sh or scripts/vault-pass-ci.sh in repo or environment)" >&2
      failed=1
    fi
  fi
done < <(git ls-files -z -- '*vault.yml')

# SECURITY: Validate Signed-off-by on all commits being pushed
# Attack: Attacker commits via --no-verify, bypassing local commit-msg hook
# Defense: Enforce Signed-off-by requirement at push time (in addition to commit-msg hook)
echo "Checking Signed-off-by requirement..." >&2
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha || [ -z "$local_ref" ]; do
  [ -n "$local_ref" ] || break

  # Skip deletions (indicated by all zeros in remote_sha)
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Get the base SHA: either remote tracking branch or start of push series
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch — validate all commits from merge-base
    base_sha=$(git merge-base "$local_sha" "origin/main" 2>/dev/null || echo "$local_sha")
  else
    # Existing branch — validate new commits only
    base_sha="$remote_sha"
  fi

  # Iterate through commits being pushed
  for commit in $(git rev-list "$base_sha..$local_sha" 2>/dev/null || true); do
    body=$(git log -1 --format=%B "$commit" 2>/dev/null || true)
    if ! printf "%s\n" "$body" | grep -q '^Signed-off-by:'; then
      echo "ERROR: Commit $commit is missing Signed-off-by: trailer" >&2
      echo "       Use: git commit -s" >&2
      failed=1
    fi
  done
done

# SECURITY: Validate GPG signatures on critical supply-chain file commits
# Attack: Attacker modifies supply-chain files (scripts, hashes) without GPG signature
# Defense: Require GPG signature when committing critical files
echo "Checking GPG signature requirement for supply-chain files..." >&2
critical_patterns=('scripts/' '.githooks/' 'collections-dist/' 'Makefile' '.github/workflows/')

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha || [ -z "$local_ref" ]; do
  [ -n "$local_ref" ] || break

  # Skip deletions
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Get the base SHA
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base_sha=$(git merge-base "$local_sha" "origin/main" 2>/dev/null || echo "$local_sha")
  else
    base_sha="$remote_sha"
  fi

  # Check each commit for critical file modifications
  for commit in $(git rev-list "$base_sha..$local_sha" 2>/dev/null || true); do
    # Check if this commit modifies any critical supply-chain files
    modified_files=$(git show "$commit" --name-only --pretty=format: 2>/dev/null || true)
    sc_file_modified=0

    for pattern in "${critical_patterns[@]}"; do
      if printf "%s\n" "$modified_files" | grep -q "^${pattern}" 2>/dev/null; then
        sc_file_modified=1
        break
      fi
    done

    if [ "$sc_file_modified" -eq 1 ]; then
      # Verify commit is GPG-signed
      if ! git verify-commit "$commit" 2>/dev/null; then
        sig_status=$(git show --format=%G? -s "$commit" 2>/dev/null || echo "N")
        echo "ERROR: Commit $commit modifies supply-chain files but is NOT GPG-signed (status: $sig_status)" >&2
        echo "       Use: git commit -s -S" >&2
        failed=1
      fi
    fi
  done
done

# SECURITY: Run gitleaks to detect secrets before push
# Attack: Attacker commits credentials (API keys, passwords, tokens) to history
# Defense: Detect secrets with gitleaks before allowing push (fail-fast prevention)
echo "Checking for secrets with gitleaks..." >&2
if command -v gitleaks >/dev/null 2>&1; then
  # Get merge base to determine what's new
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha || [ -z "$local_ref" ]; do
    [ -n "$local_ref" ] || break

    # Skip deletions
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      continue
    fi

    # Determine what range to check (new commits being pushed)
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      # New branch — check from merge-base to HEAD
      range="$(git merge-base "$local_sha" "origin/main" 2>/dev/null || echo "$local_sha")..${local_sha}"
    else
      # Existing branch — check only new commits
      range="${remote_sha}..${local_sha}"
    fi

    # Run gitleaks on the range being pushed (skip errors, as gitleaks may not be in PATH)
    if gitleaks git --log-opts "$range" --redact --no-color 2>/dev/null || true; then
      : # gitleaks passed (no secrets found)
    else
      gitleaks_rc=$?
      if [ "$gitleaks_rc" -ne 0 ] && [ "$gitleaks_rc" -ne 127 ]; then
        # 127 = gitleaks not found (OK, CI will catch), any other code = actual failure
        echo "ERROR: gitleaks detected potential secrets in commits being pushed" >&2
        echo "       Review the output above and remove secrets before pushing" >&2
        failed=1
      fi
    fi
  done
else
  # gitleaks not installed — warn but don't fail (CI will catch this)
  echo "WARNING: gitleaks not installed — skipping secret detection (CI will enforce this)" >&2
fi

exit $failed
