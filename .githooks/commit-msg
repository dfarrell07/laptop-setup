#!/bin/sh
# Enforce imperative mood commit messages (Tim Pope style)
msg=$(head -1 "$1")
first=$(echo "$msg" | awk '{print $1}')
first="${first%:}"
# Extract the description word — the first word after "Scope: " (or the first word if no scope)
# This is what should be imperative mood.
desc_first=$(echo "$msg" | sed 's/^[-A-Za-z/]*:[[:space:]]*//' | awk '{print $1}')

# Allow git autosquash prefixes and merge commits unchanged
case "$msg" in
  squash!*|fixup!*|amend!*) exit 0 ;;
  Merge\ branch*|Merge\ pull*|Merge\ remote*) exit 0 ;;
esac

# Check capitalized
if ! echo "$msg" | grep -qE '^[A-Z]'; then
  echo "ERROR: Capitalize the subject line" >&2
  exit 1
fi

# Reject common past tense and gerund first words in the description (after scope colon)
_bad_word() {
  _w=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  case "$_w" in
    added|changed|created|deleted|enabled|disabled|expanded|fixed|\
    implemented|improved|merged|moved|refactored|removed|renamed|\
    replaced|resolved|reverted|started|stopped|updated|upgraded|\
    adding|changing|creating|deleting|enabling|disabling|expanding|\
    fixing|implementing|improving|merging|moving|refactoring|removing|\
    renaming|replacing|resolving|reverting|starting|stopping|updating|\
    upgrading) return 0 ;;
    *) return 1 ;;
  esac
}
# Check description word (word after "Scope: ") — this is the critical tense check
if _bad_word "$desc_first"; then
  echo "ERROR: Use imperative mood ('$desc_first' is not imperative)" >&2
  echo "  Write 'Scope: fix ...' not 'Scope: Fixed/Fixing ...'" >&2
  exit 1
fi
# Also catch when the scope word itself is a banned past-tense/gerund word (e.g. 'Fixed: add ...')
if [ "$desc_first" != "$first" ] && _bad_word "$first"; then
  echo "ERROR: Use imperative mood ('$first' is not imperative)" >&2
  exit 1
fi

# Check length (wc -m counts Unicode characters, not bytes — consistent with deployed global hook)
len=$(printf '%s' "$msg" | wc -m)
if [ "$len" -gt 72 ]; then
  echo "ERROR: Subject too long ($len > 72 chars)" >&2
  exit 1
fi

# No trailing period
if echo "$msg" | grep -qE '\.$'; then
  echo "ERROR: No trailing period on subject line" >&2
  exit 1
fi

# Require Signed-off-by (enforce 'git commit -s')
if ! grep -q '^Signed-off-by:' "$1"; then
  echo "ERROR: Missing Signed-off-by — use 'git commit -s'" >&2
  exit 1
fi

# Run commitlint for remaining rules (body blank line, etc.)
if command -v npx >/dev/null 2>&1 && [ -x "./node_modules/.bin/commitlint" ]; then
  npx --no -- commitlint --edit "$1"
elif command -v npx >/dev/null 2>&1; then
  echo "WARNING: commitlint not installed — run: make bootstrap" >&2
else
  echo "WARNING: npx not found — commitlint skipped. Run make bootstrap to install Node.js deps." >&2
fi
