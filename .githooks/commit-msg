#!/bin/bash
# Reject past-tense/gerund first words in commit description (allows noun-phrase subjects per repo convention)
msg=$(head -1 "$1")

# SECURITY: Require Signed-off-by trailer (text in commit message via 'git commit -s')
# IMPORTANT: This is the TEXT check only. See note below about GPG signature (-S).
# Checked before any early-exit so reverts are also covered
if ! grep -q '^Signed-off-by:' "$1"; then
  echo "ERROR: Missing Signed-off-by trailer — use --signoff / -s with your git command" >&2
  echo "" >&2
  echo "NOTE: -s adds text only (not cryptographic). For supply-chain files, you ALSO need -S:" >&2
  echo "  git commit -s -S" >&2
  echo "" >&2
  echo "See SECURITY.md § 'Supply-Chain Commits: -s vs -S' for the distinction." >&2
  exit 1
fi

# SECURITY: If critical supply-chain files are staged, require GPG signing configuration
# Prevents unsigned commits that modify scripts + hashes in the same commit.
# NOTE: This enforces 'git commit -S' (cryptographic GPG signature), complementary to -s above
_sc_files_modified=0
if git diff --cached --quiet --diff-filter=ACMR -- 'scripts/verify-collections.sh' 'scripts/verify-collections.sh.sha256' 'scripts/verify-ansible-args.sh' 'scripts/verify-ansible-args.sh.sha256' 'collections-dist/SHA256SUMS' 'collections-dist/*.tar.gz' 2>/dev/null; then
  : # No changes to critical files
else
  _sc_files_modified=1
fi

# SECURITY: Enforce GPG signing (cryptographic signature via -S) for critical supply-chain files
# NOTE: This is the CRYPTOGRAPHIC signature check (complement to -s Signed-off-by text check above)
# Prevents unsigned commits that modify scripts + hashes in the same commit
if [ "$_sc_files_modified" -eq 1 ]; then
  if ! git config --local --bool commit.gpgsign 2>/dev/null | grep -q 'true'; then
    if ! git config --global --bool commit.gpgsign 2>/dev/null | grep -q 'true'; then
      echo "ERROR: Critical supply-chain files modified but GPG signing not configured" >&2
      echo "" >&2
      echo "This commit MUST have BOTH mechanisms:" >&2
      echo "  1. Signed-off-by text (-s): enforced in previous check above" >&2
      echo "  2. GPG signature (-S): requires configuration or explicit flag" >&2
      echo "" >&2
      echo "Option A (recommended): Configure git to always GPG-sign" >&2
      echo "  git config --global commit.gpgsign true" >&2
      echo "  Then: git commit -s  (GPG signing added automatically)" >&2
      echo "" >&2
      echo "Option B: Sign supply-chain commits explicitly" >&2
      echo "  git commit -s -S  (both -s and -S flags)" >&2
      echo "" >&2
      echo "Setup: Import your GPG key first (see SECURITY.md § GPG Key Import section)" >&2
      echo "See SECURITY.md § 'Supply-Chain Commits: -s vs -S' for full details." >&2
      exit 1
    fi
  fi
fi

# Signed-off-by still required above; these prefixes skip scope/tense/length checks only
case "$msg" in
  squash!*|fixup!*|amend!*) exit 0 ;;
  Merge\ branch*|Merge\ pull*|Merge\ remote*|'Merge tag'*) exit 0 ;;
  Revert\ *) exit 0 ;;
esac
if ! echo "$msg" | grep -qE '^[A-Z][-A-Za-z0-9/]*:[[:space:]]'; then
  echo "ERROR: Missing or uncapitalized scope — format must be 'Scope: description' (space after colon required)" >&2
  exit 1
fi
# Extract scope portion for scope-parts bad-word check below
first=$(echo "$msg" | sed 's/^\([A-Z][-A-Za-z0-9/]*\):.*/\1/')
# Extract the description word — the first word after "Scope: "
# This is what should be imperative mood.
desc_first=$(echo "$msg" | sed 's/^[A-Z][-A-Za-z0-9/]*:[[:space:]]*//' | awk '{print $1}')
desc_first="${desc_first%:}"  # strip trailing colon: 'Added:' would not match 'added' in case without this
if [ -z "$desc_first" ]; then
  echo "ERROR: Subject has no description after scope colon" >&2
  exit 1
fi

# Reject common past tense and gerund first words in the description (after scope colon)
_bad_word() {
  local _w
  _w=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  case "$_w" in
    added|changed|created|deleted|enabled|disabled|expanded|fixed|\
    implemented|improved|merged|moved|refactored|removed|renamed|\
    replaced|resolved|reverted|started|stopped|updated|upgraded|\
    adding|changing|creating|deleting|enabling|disabling|expanding|\
    fixing|implementing|improving|merging|moving|refactoring|removing|\
    renaming|replacing|resolving|reverting|starting|stopping|updating|\
    upgrading) return 0 ;;
    *) return 1 ;;
  esac
}
# Check description word (word after "Scope: ") — this is the critical tense check
if _bad_word "$desc_first"; then
  echo "ERROR: Use noun-phrase or imperative (not past-tense/gerund): write 'Scope: log addition' or 'Scope: add logging', not 'Scope: Added logging' ('$desc_first' is banned)" >&2
  exit 1
fi
# Also catch when the scope word itself is a banned past-tense/gerund word (e.g. 'Fixed: add ...')
# Split on '/' to handle multi-scope commits like 'Fixed/System: add foo'
IFS='/' read -ra _scope_parts <<< "$first"
for _part in "${_scope_parts[@]}"; do
  if _bad_word "$_part"; then
    echo "ERROR: Scope word '$_part' is a past-tense/gerund — use a role-area name (see CLAUDE.md scopes)" >&2
    exit 1
  fi
done

# Check length (wc -m counts Unicode characters, not bytes — consistent with deployed global hook)
# This value must match header-max-length in commitlint.config.js
len=$(printf '%s' "$msg" | LC_ALL=en_US.UTF-8 wc -m)
if [ "$len" -gt 72 ]; then
  echo "ERROR: Subject too long ($len > 72 chars)" >&2
  exit 1
fi

# No trailing period
if echo "$msg" | grep -qE '\.$'; then
  echo "ERROR: Remove trailing period from subject line" >&2
  exit 1
fi

# Sync partner: roles/dotfiles/files/git-template-commit-msg — keep ENTIRE hook logic identical in both files (not just the commitlint block)
if command -v npx >/dev/null 2>&1; then
  if [ -x "./node_modules/.bin/commitlint" ]; then
    npx --no -- commitlint --edit "$1"
    exit $?
  else
    echo "WARNING: commitlint not found in ./node_modules — run: npm install --ignore-scripts (or: make bootstrap)" >&2
    exit 0
  fi
else
  echo "WARNING: npx not found — commitlint skipped. Run make bootstrap to install Node.js deps." >&2
  exit 0
fi
