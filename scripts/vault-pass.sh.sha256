# vault-pass.sh SHA256 integrity reference
# This file stores the expected SHA256 hash of scripts/vault-pass.sh
# Used for runtime integrity verification to detect tampering or replacement
# IMPORTANT: This file is only valid for vault-pass.sh created by make bootstrap
# or manually copied from vault-pass-ci.sh. YubiKey-encrypted vault-pass.sh will
# have a different hash and this check will fail until setup-yubikeys.sh updates
# the hash (see: scripts/setup-yubikeys.sh)
#
# Hash format: one hash per line (same as sha256sum output)
# If vault-pass.sh has been replaced or tampered with, this check will fail.
#
0d8b3c3d42d3bb27e38551a6eb051dd0f2e31f8543c6b13d9953168db5840401  vault-pass.sh
