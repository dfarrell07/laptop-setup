---
# Per-profile Chrome bookmarks (docs/chrome-bookmarks.md). Copy to local_bookmarks.yml at the repo root (gitignored), edit, then run
# `make chrome-bookmarks` and import each profile's file once in that profile. http:// and https:// only.
chrome_bookmarks:
  work:
    - name: Team tracker
      url: https://tracker.example.internal/team
    - folder: Docs
      items:
        - name: Runbook
          url: https://docs.example.internal/runbook
  personal:
    - name: Calendar
      url: https://calendar.example.com/
