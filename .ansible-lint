---
profile: production

exclude_paths:
  - collections/
  - .github/
  - molecule/shared/  # task-include files; not standalone playbooks — linted via scenario verify.yml inclusion

skip_list:
  - yaml  # yamllint --strict handles all yaml rules, including .github/ and line-length
  - var-naming[no-role-prefix]  # cross-role shared vars and underscore-prefixed register vars
