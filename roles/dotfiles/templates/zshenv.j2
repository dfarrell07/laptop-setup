# {{ ansible_managed }}
# macOS: ssh and mosh run remote commands through `zsh -c` with PATH=/usr/bin:/bin:/usr/sbin:/sbin and read only this
# file, not .zshrc, as do launchd jobs and editors that start `zsh -c`. So the PATH every zsh needs is set here, once:
# ~/.local/bin and ~/go/bin, the GNU tools ahead of the BSD ones, Homebrew's unversioned python, then Homebrew (mosh-server,
# `mac-claude`'s tmux). A login shell then runs /etc/zprofile, whose path_helper moves the system directories back in
# front, so .zshrc calls _laptop_path again.
typeset -U path PATH  # prepending an entry already present moves it to the front
_laptop_path() {
  local _brew="{{ dotfiles_homebrew_prefix | trim }}" _tool
  # the user tool dirs .zshrc lists (codex from npm, go install, cargo, krew), in its order
  local -a _first=("$HOME/.local/bin" "$HOME/.npm-global/bin" "$HOME/go/bin" "$HOME/bin" "$HOME/.cargo/bin" "$HOME/.krew/bin")
{% if dotfiles_macos_gnu_tools | bool %}
  # GNU make, tar, awk, find, grep, sed and coreutils, so commands behave as on Linux
  for _tool in make gnu-tar gawk findutils grep gnu-sed coreutils; do
    [[ -d "$_brew/opt/$_tool/libexec/gnubin" ]] && _first+=("$_brew/opt/$_tool/libexec/gnubin")
  done
{% endif %}
  # python, python3 and pip ({{ dotfiles_macos_python }}), as /usr/bin/python on Fedora; also keeps python3 on the version
  # the repo venvs and pipx use rather than Homebrew's newest
  [[ -d "$_brew/opt/{{ dotfiles_macos_python }}/libexec/bin" ]] && _first+=("$_brew/opt/{{ dotfiles_macos_python }}/libexec/bin")
  path=("${_first[@]}" "$_brew/bin" "${path[@]}")
  export PATH
}
_laptop_path
# Defaults for scripts and agents too (.zshrc sets the same values in interactive shells); a value already set, such as
# an IDE's EDITOR or a build's GOTOOLCHAIN, wins
: ${EDITOR:=vim} ${VISUAL:=vim} ${GOPATH:=$HOME/go} ${GOTOOLCHAIN:={{ packages_gotoolchain | default('auto') }}}
: ${LANG:=en_US.UTF-8}  # mosh-server needs a UTF-8 locale; ssh passes the client's LANG when it has one
export EDITOR VISUAL GOPATH GOTOOLCHAIN LANG
# Docker clients (kind, docker-compose, testcontainers) use the podman machine's API socket, as on Linux the rootless
# podman socket (zshrc); TMPDIR is set in local and ssh sessions. Only a socket this user owns, and never over a
# DOCKER_HOST already set or where Docker Desktop is installed: ~/.docker/run/docker.sock, which its docker context
# uses, exists while it runs and can be left behind when it stops, so a stale one also keeps DOCKER_HOST unset
_laptop_docker_sock="${TMPDIR%/}/podman/"{{ (containers_macos_machine_name ~ '-api.sock') | quote }}
[[ -z "${DOCKER_HOST:-}" && ! -e "$HOME/.docker/run/docker.sock" && -n "${TMPDIR:-}" && -S "$_laptop_docker_sock" \
  && -O "$_laptop_docker_sock" ]] && export DOCKER_HOST="unix://$_laptop_docker_sock"
unset _laptop_docker_sock
export KIND_EXPERIMENTAL_PROVIDER=podman  # use the Podman provider (not docker-provider-via-socket)
