# {{ ansible_managed }}
# ~/.config/git/ignore — global gitignore (XDG path, read automatically by Git)

# Vim / editor artifacts
*.swp
*.swo
*~
.idea/
.vscode/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/

# C / eBPF build artifacts
*.o
*.d
*.a

# Go test binaries (go test -c output, never committed)
*.test

# Rust build output
target/

# direnv (local env cache, never committed)
.direnv/

# Environment / secrets files — never commit
.env
.env.local
.env.*.local

# Log files
*.log

# ctags / etags index files (C and Go development)
tags
TAGS
.tags
.TAGS
