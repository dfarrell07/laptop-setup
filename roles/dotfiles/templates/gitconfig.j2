# {{ ansible_managed }}
{% set _system = ansible_facts['system'] | default('Linux') %}
[user]
	name = {{ dotfiles_user_name | trim | regex_replace('[\r\n].*', '') }}
	email = {{ (dotfiles_user_email_work if profile == 'work' else dotfiles_user_email_personal) | regex_replace('[\r\n].*', '') }}
{% if ssh_signing_key_pub | trim | length > 0 %}
	signingkey = ~/.ssh/{{ ssh_signing_key_basename }}.pub

[commit]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
{% endif %}

[branch]
	sort = -committerdate

[tag]
{% if ssh_signing_key_pub | trim | length > 0 %}
	gpgsign = true
{% endif %}
	sort = -version:refname

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autosquash = true
	autostash = true

[merge]
	conflictStyle = zdiff3
{% if _system == 'Linux' %}
	tool = meld
{% endif %}

[mergetool]
	prompt = false

[rerere]
	enabled = true

# GitHub transport. Your own repos and forks (github.com/{{ dotfiles_github_user }}/) use HTTPS with gh's credentials
# (credential helper below), so agents can fetch and push to them without a YubiKey touch. Pushes to anyone else's
# repos go over SSH, so the YubiKey still guards them. git pushsk [remote] [refspec...] always pushes over SSH (an
# explicit-port URL no rewrite matches); it takes no --force-with-lease, which needs a remote name.
[url "ssh://git@github.com/"]
	pushInsteadOf = https://github.com/
[url "https://github.com/{{ dotfiles_github_user }}/"]
	insteadOf = git@github.com:{{ dotfiles_github_user }}/
	insteadOf = ssh://git@github.com/{{ dotfiles_github_user }}/
	pushInsteadOf = https://github.com/{{ dotfiles_github_user }}/

[alias]
	pushsk = "!f() { r=${1:-origin}; [ $# -gt 0 ] && shift; [ $# -gt 0 ] || set -- HEAD; u=$(git remote get-url \"$r\") || return; case $u in https://github.com/*) p=${u#https://github.com/};; git@github.com:*) p=${u#git@github.com:};; ssh://git@github.com/*) p=${u#ssh://git@github.com/};; *) echo \"pushsk: $r is not a GitHub remote\" >&2; return 1;; esac; git push \"ssh://git@github.com:22/$p\" \"$@\"; }; f"
	logg = log --oneline --graph --decorate --all
	uncommit = reset HEAD~1
	unstage = restore --staged
	pushf = push --force-with-lease
	fixup = commit -s --fixup
	wip = commit -s -m 'WIP: snapshot'
	revert-s = revert -s
	stash-all = stash --include-untracked

[diff]
{% if _system == 'Linux' %}
	tool = meld
{% endif %}
	algorithm = histogram

[difftool]
	prompt = false

[help]
	autocorrect = prompt

[core]
	hooksPath = ~/.config/git/template/hooks
	excludesfile = ~/.config/git/ignore
	fsmonitor = false

[safe]
	bareRepository = explicit

[transfer]
	fsckObjects = true
[fetch]
	fsckObjects = true
	prune = true
# Old commits in some upstreams (FRRouting/frr) carry malformed timezones; this cosmetic check otherwise aborts the
# clone. Path, symlink and .gitmodules checks stay errors.
[fetch "fsck"]
	badTimezone = ignore
[receive]
	fsckObjects = true

[init]
	defaultBranch = main

[protocol]
	allow = never
[protocol "https"]
	allow = always
[protocol "ssh"]
	allow = always
[protocol "file"]
	allow = user

# The empty helper drops helpers set earlier for github.com (the Xcode CLT system gitconfig adds osxkeychain,
# which can hang on a keychain prompt with nobody at the screen); gh then answers alone. macOS names gh by path:
# launchd jobs and non-login shells do not have Homebrew on PATH.
[credential "https://github.com"]
	helper =
{% if _system == 'Darwin' %}
	helper = !{{ dotfiles_homebrew_prefix | trim }}/bin/gh auth git-credential
{% else %}
	helper = !gh auth git-credential
{% endif %}

{% if profile == 'work' %}{% for org in dotfiles_work_src_dirs %}
[includeIf "gitdir:~/src/{{ org | regex_replace('[^a-zA-Z0-9_-]', '') }}/"]
	path = ~/.config/git/config-work

{% endfor %}{% endif %}
{% if dotfiles_github_user != 'CHANGE_ME' %}
# Personal email override — only active for repos under ~/src/{{ dotfiles_github_user }}/
# Repos cloned elsewhere (~/personal/, ~/tmp/, etc.) use the base [user] email above.
[includeIf "gitdir:~/src/{{ dotfiles_github_user | regex_replace('[^a-zA-Z0-9_-]', '') }}/"]
	path = ~/.config/git/config-personal
{% endif %}

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
