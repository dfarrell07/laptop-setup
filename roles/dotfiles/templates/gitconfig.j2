# {{ ansible_managed }}
{% set _system = ansible_facts['system'] | default('Linux') %}
[user]
	name = {{ dotfiles_user_name }}
	email = {{ dotfiles_user_email_work if profile == 'work' else dotfiles_user_email_personal }}
{% if ssh_git_signing_pubkey | trim | length > 0 %}
	signingkey = ~/.ssh/{{ ssh_signing_key_basename }}.pub

[commit]
	gpgsign = true
	signoff = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
{% endif %}

[branch]
	sort = -committerdate

[tag]
{% if ssh_git_signing_pubkey | trim | length > 0 %}
	gpgsign = true
{% endif %}
	sort = -version:refname

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autosquash = true
	autostash = true

[merge]
	conflictStyle = zdiff3
{% if _system == 'Linux' %}
	tool = meld
{% endif %}

[mergetool]
	prompt = false

[rerere]
	enabled = true

[url "ssh://git@github.com/"]
	pushInsteadOf = https://github.com/

[alias]
	logg = log --oneline --graph --decorate --all
	uncommit = reset HEAD~1
	unstage = restore --staged
	pushf = push --force-with-lease
	fixup = commit --fixup
	wip = commit -s -m WIP
	revert-s = revert -s
	stash-all = stash --include-untracked
	# 'recent' alias removed — [branch] sort = -committerdate makes plain 'git branch' sort by recency

[diff]
{% if _system == 'Linux' %}
	tool = meld
{% endif %}
	algorithm = histogram

[difftool]
	prompt = false

[help]
	autocorrect = prompt

[core]
	hooksPath = ~/.config/git/template/hooks
	excludesfile = ~/.config/git/ignore
	fsmonitor = false

[safe]
	bareRepository = explicit

[transfer]
	fsckObjects = true
[fetch]
	fsckObjects = true
	prune = true
[receive]
	fsckObjects = true

[init]
	defaultBranch = main

[protocol]
	allow = never
[protocol "https"]
	allow = always
[protocol "ssh"]
	allow = always
[protocol "file"]
	allow = user

[credential "https://github.com"]
	helper = !gh auth git-credential
{% if profile == 'work' and _system == 'Linux' and dotfiles_internal_git_host != '' %}

[http "https://{{ dotfiles_internal_git_host }}"]
	sslCAInfo = {{ dotfiles_internal_ca_path }}
{% endif %}

{% for org in dotfiles_work_src_dirs %}
[includeIf "gitdir:~/src/{{ org }}/"]
	path = ~/.config/git/config-work

{% endfor %}
{% if dotfiles_github_user != 'CHANGE_ME' %}
[includeIf "gitdir:~/src/{{ dotfiles_github_user }}/"]
	path = ~/.config/git/config-personal
{% endif %}

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
