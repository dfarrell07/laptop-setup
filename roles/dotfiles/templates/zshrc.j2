# --- Kubernetes ---
# Ensure compinit is available (oh-my-zsh initializes it, but guard for when it's absent)
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit }
# kubectl completion is provided by the oh-my-zsh kubectl plugin (no duplicate load needed)
# Cache completions for tools not covered by oh-my-zsh plugins; regenerate when binary changes.
_zsh_cached_completion() {
  local cmd="$1"; shift
  command -v "$cmd" &>/dev/null || return 0
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
  local cache_file="$cache_dir/${cmd}.zsh"
  local binary
  binary=$(command -v "$cmd")
  if [[ ! -f "$cache_file" || "$binary" -nt "$cache_file" ]]; then
    mkdir -p "$cache_dir"
    "$cmd" "$@" > "$cache_file" 2>/dev/null
  fi
  [[ -s "$cache_file" ]] && source "$cache_file"
}
_zsh_cached_completion oc completion zsh
_zsh_cached_completion helm completion zsh
_zsh_cached_completion kind completion zsh
_zsh_cached_completion kustomize completion zsh
if command -v bpfman &>/dev/null; then
  _bpf_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions/bpfman.zsh"
  _bpf_bin=$(command -v bpfman)
  if [[ ! -f "$_bpf_cache" || "$_bpf_bin" -nt "$_bpf_cache" ]]; then
    mkdir -p "${_bpf_cache:h}"
    _bpf_tmp=$(mktemp -d)
    bpfman completions "$_bpf_tmp" --shell zsh 2>/dev/null
    [[ -f "$_bpf_tmp/_bpfman" ]] && mv -f "$_bpf_tmp/_bpfman" "$_bpf_cache"
    rm -rf "$_bpf_tmp"
  fi
  [[ -s "$_bpf_cache" ]] && source "$_bpf_cache"
fi

