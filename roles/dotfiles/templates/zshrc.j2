# {{ ansible_managed }}
# ~/.zshrc — managed by Ansible (roles/dotfiles)

export ZSH="$HOME/.local/share/oh-my-zsh"
ZSH_THEME="{{ dotfiles_oh_my_zsh_theme }}"

zstyle ':omz:update' mode disabled

plugins=({{ dotfiles_oh_my_zsh_plugins | join(' ') }})

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# --- Environment ---
export EDITOR=vim
export VISUAL=vim
{% if profile == 'work' %}
export AWS_PROFILE="{{ dotfiles_aws_profile }}"
export GONOSUMDB="*.redhat.com,*.engineering.redhat.com"
export GOPRIVATE="gitlab.cee.redhat.com,pkgs.devel.redhat.com"
{% endif %}
export PATH="$HOME/.local/bin:$HOME/bin:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.krew/bin:$PATH"
export GOPATH="$HOME/go"
export GOTMPDIR="$HOME/tmp"  # go test compiles to TempDir then exec()s — /tmp is noexec on this host
export KUBECONFIG="$HOME/.kube/config"
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
unsetopt SHARE_HISTORY  # oh-my-zsh sets this; unset so APPEND_HISTORY controls write behavior
setopt APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
{% if ansible_system | default('Linux') == 'Darwin' %}
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$HOME/.ssh/ssh-agent.socket}"  # preserve existing socket if set
{% endif %}
export TMUX_TMPDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/tmux"
export REGISTRY_AUTH_FILE="$HOME/.config/containers/auth.json"
export DIRENV_LOG_FORMAT=""  # suppress verbose 'direnv: loading .envrc' output on every cd
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
command -v rg &>/dev/null && export FZF_DEFAULT_COMMAND='rg --files --follow'
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
{% if ansible_system | default('Linux') == 'Linux' %}
# SSH_AUTH_SOCK fallback for shells that bypass systemd user session (sudo -s, su -)
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket}"
export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
export KIND_EXPERIMENTAL_PROVIDER=podman  # use rootless Podman provider (not docker-provider-via-socket)
# Wayland-native rendering for Qt and Electron when running under Sway
[[ "${XDG_CURRENT_DESKTOP}" == "sway" ]] && export QT_QPA_PLATFORM=wayland
[[ "${XDG_CURRENT_DESKTOP}" == "sway" ]] && export ELECTRON_OZONE_PLATFORM_HINT=wayland
[[ "${XDG_CURRENT_DESKTOP}" == "sway" ]] && export _JAVA_AWT_WM_NONREPARENTING=1
# XDG_SESSION_TYPE: set by DM on graphical login; ensure it's set for TTY-launched Sway
[[ "${XDG_CURRENT_DESKTOP}" == "sway" && -z "${XDG_SESSION_TYPE}" ]] && export XDG_SESSION_TYPE=wayland
{% endif %}

# --- Tool hooks (silently skip if not installed) ---
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"
{% if ansible_system | default('Linux') == 'Linux' %}
command -v fzf &>/dev/null && [[ -f /usr/share/fzf/shell/key-bindings.zsh ]] && source /usr/share/fzf/shell/key-bindings.zsh
# Fedora rpm ships completion via /usr/share/zsh/site-functions/_fzf (picked up by compinit);
# completion.zsh does not exist in the Fedora package. No explicit source needed for rpm installs.
{% elif ansible_system == 'Darwin' %}
command -v fzf &>/dev/null && [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
command -v fzf &>/dev/null && [[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]] && source /opt/homebrew/opt/fzf/shell/completion.zsh
{% endif %}

# --- zsh quality-of-life plugins ---
{% if ansible_system | default('Linux') == 'Linux' %}
[[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{% elif ansible_system == 'Darwin' %}
[[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{% endif %}

# --- Claude Code API endpoint guard ---
_claude_check_base_url() {
  if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
    if [[ "${ANTHROPIC_BASE_URL}" != https://* ]]; then
      echo "BLOCKED: ANTHROPIC_BASE_URL must use https:// (got: ${ANTHROPIC_BASE_URL})" >&2
      return 1
    fi
    local host="${ANTHROPIC_BASE_URL#https://}"; host="${host#*@}"; host="${host%%[:/]*}"
    if [[ "$host" != "api.anthropic.com" && "$host" != *-aiplatform.googleapis.com ]]; then
      echo "BLOCKED: ANTHROPIC_BASE_URL=$host (untrusted)" >&2
      return 1
    fi
  fi
}

# --- Claude Code instance guard ---
claude() {
  if [[ -z "${CLAUDE_CONFIG_DIR:-}" ]]; then
    echo "ERROR: CLAUDE_CONFIG_DIR not set. Use 'cw' (work) or 'ccp' (personal)." >&2
    return 1
  fi
  _claude_check_base_url || return 1
  command claude "$@"
}

# --- Claude Code in tmux (sessions survive disconnects) ---
{% if profile == 'work' %}
cw() {
  command -v tmux &>/dev/null || { echo "ERROR: tmux not found"; return 1; }
  _claude_check_base_url || return 1
  local dir="${PWD##*/}"; dir="${dir//[^a-zA-Z0-9_-]/_}"; [[ -z "$dir" ]] && dir="root"
  local s="work-${dir}"
  tmux new-session -As "$s" "source ~/.config/claude/work-env && claude; zsh"
}
{% endif %}

ccp() {
  command -v tmux &>/dev/null || { echo "ERROR: tmux not found"; return 1; }
  local phys="$(pwd -P)"
  if [[ "$phys" == */src/submariner-io/* || "$phys" == */src/stolostron/* || "$phys" == */src/ovnk/* || "$phys" == */src/konflux/* || "$phys" == */src/bpfman/* || "$phys" == */src/ds/* || "$phys" == */src/cncf/* ]]; then
    echo "ERROR: Work directory detected. Use 'cw' for work repos." >&2; return 1
  fi
  _claude_check_base_url || return 1
  local dir="${PWD##*/}"; dir="${dir//[^a-zA-Z0-9_-]/_}"; [[ -z "$dir" ]] && dir="root"
  local s="personal-${dir}"
  tmux new-session -As "$s" "unset CLAUDE_CODE_USE_VERTEX ANTHROPIC_VERTEX_PROJECT_ID CLOUD_ML_REGION GOOGLE_APPLICATION_CREDENTIALS GOOGLE_CLOUD_PROJECT; CLAUDE_CONFIG_DIR=$HOME/.claude-personal claude; zsh"
}

cls() { tmux list-sessions 2>/dev/null | grep -E "work-|personal-"; }
ca() { command -v fzf &>/dev/null || { echo "ca: fzf not installed" >&2; return 1; }; local s; s=$(tmux list-sessions -F '#{session_name}' | grep -E 'work-|personal-' | fzf --height=40% --prompt="Attach: ") && [[ -n "$s" ]] && tmux attach -t "$s"; }
{% if profile == 'work' %}
cwt() {
  local n="${1:?Usage: cwt <worktree-name>}"
  if [[ "$n" =~ [^a-zA-Z0-9_-] ]]; then
    echo "ERROR: worktree name must use only alphanumeric, dash, underscore (got: $n)" >&2
    return 1
  fi
  _claude_check_base_url || return 1
  tmux new-session -As "work-$n" "source ~/.config/claude/work-env && claude --worktree $n; zsh"
}
{% endif %}
cstatus() {
  for s in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E 'work-|personal-'); do
    echo "=== $s ==="; tmux capture-pane -t "$s" -p | tail -3; echo
  done
}

# --- Device access (Tailscale + mosh) ---
alias laptop='mosh laptop.tail'
alias mac='mosh mac-desktop.tail'
laptop-claude() { mosh laptop.tail -- tmux new-session -A -s "${1:-work}"; }
mac-claude() { mosh mac-desktop.tail -- tmux new-session -A -s "${1:-personal}"; }
alias rc='claude --remote-control'

# --- Quick nav ---
alias src='cd ~/src'
alias subm='cd ~/src/submariner-io'
alias ovnk='cd ~/src/ovnk'
alias notes='cd ~/src/{{ dotfiles_github_user }}/notes-ai'

# --- Task queue ---
cq() { gh issue create --repo {{ dotfiles_github_user }}/claude-tasks --title "$1" --body "$2"; }

# --- Kubernetes tool completions ---
# Ensure compinit is available (oh-my-zsh initializes it, but guard for when it's absent)
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit }
command -v kubectl &>/dev/null && source <(kubectl completion zsh)
command -v oc &>/dev/null && source <(oc completion zsh)
command -v helm &>/dev/null && source <(helm completion zsh)
command -v kind &>/dev/null && source <(kind completion zsh)
command -v kustomize &>/dev/null && source <(kustomize completion zsh)
command -v bpfman &>/dev/null && source <(bpfman completion zsh) 2>/dev/null

# --- Kubernetes helpers ---
# kctx: fzf kubeconfig file picker — exports selected file as KUBECONFIG
kctx() {
  command -v fzf &>/dev/null || { echo "kctx: fzf required" >&2; return 1; }
  local f
  f=$(find "$HOME/.kube" -maxdepth 1 \( -name '*.yaml' -o -name '*.yml' -o -name 'config*' \) 2>/dev/null \
      | fzf --prompt="kubeconfig: " --height=40%) || return
  export KUBECONFIG="$f"
}
# klogs: fzf pod picker then kubectl logs -f (pass extra args e.g. --container, --previous)
klogs() {
  command -v fzf &>/dev/null || { echo "klogs: fzf required" >&2; return 1; }
  local sel ns pod
  sel=$(kubectl get pods -A 2>/dev/null | fzf --header-lines=1 --prompt="pod: " --height=50%) || return
  ns=$(awk '{print $1}' <<<"$sel"); pod=$(awk '{print $2}' <<<"$sel")
  kubectl logs -f -n "$ns" "$pod" "$@"
}

# --- Status ---
{% if ansible_system | default('Linux') != 'Darwin' %}
command -v vimx &>/dev/null && alias vim=vimx  # vimx (+clipboard) from vim-X11 package
{% endif %}
alias yk='ykman info'
{% if ansible_system | default('Linux') == 'Darwin' %}
alias vpn='netstat -rn | grep -E "utun|wg"'
{% else %}
alias vpn='ip route | grep -E "tun|wg"'
{% endif %}
alias ts='tailscale status'

# --- General aliases ---
alias gv="gvim -vp"
alias gi="grep -rniI --color=always --exclude-dir=vendor"
alias ping="ping -i .2"
alias pingg="ping www.google.com"
alias ping8="ping 8.8.8.8"

# --- umask ---
umask 077
