# helpers:
# kfiles: fzf kubeconfig FILE picker — exports selected file as KUBECONFIG
# (for context switching within a kubeconfig, use: kubectl ctx / kubectl krew install ctx)
kfiles() {
  command -v fzf &>/dev/null || { echo "kfiles: fzf required" >&2; return 1; }
  local f
  f=$(find "$HOME/.kube" -maxdepth 1 \( -name '*.yaml' -o -name '*.yml' -o -name 'config*' \) 2>/dev/null \
      | fzf --prompt="kubeconfig file: " --height=40%) || return
  export KUBECONFIG="$f"
}
# klogs: fzf pod picker then kubectl logs -f (pass extra args e.g. --container, --previous)
klogs() {
  command -v fzf &>/dev/null || { echo "klogs: fzf required" >&2; return 1; }
  local sel ns pod
  sel=$(kubectl get pods -A 2>/dev/null | fzf --header-lines=1 --prompt="pod: " --height=50%) || return
  ns=$(awk '{print $1}' <<<"$sel"); pod=$(awk '{print $2}' <<<"$sel")
  kubectl logs -f -n "$ns" "$pod" "$@"
}
# kenv: seed a per-repo .envrc with KUBECONFIG for direnv auto-switching
kenv() {
  local cfg="${1:-$KUBECONFIG}"
  [[ -z "$cfg" ]] && { echo "kenv: no KUBECONFIG set or given" >&2; return 1; }
  local envrc="${PWD}/.envrc"
  # Replace existing KUBECONFIG line or append — prevents duplicate entries on repeated calls
  if grep -q "^export KUBECONFIG=" "$envrc" 2>/dev/null; then
    sed -i "s|^export KUBECONFIG=.*|export KUBECONFIG=$cfg|" "$envrc"
  else
    echo "export KUBECONFIG=$cfg" >> "$envrc"
  fi
  direnv allow .
}
# sp: tmux project sessionizer — jump to ~/src project with fzf, create session if needed
sp() {
  command -v fzf &>/dev/null || { echo "sp: fzf required" >&2; return 1; }
  local dir
  dir=$(find "$HOME/src" -mindepth 1 -maxdepth 3 -type d 2>/dev/null | fzf --prompt="project: " --height=50%) || return
  local name
  name=$(basename "$dir" | tr '.' '_')
  tmux new-session -As "$name" -c "$dir"
}

{% if profile == 'work' %}
# --- OVN-K/bpfman workflow ---
# Namespace-pinned kubectl: typing -n ovn-kubernetes on every command is the #1 daily friction.
alias kovnk='kubectl -n ovn-kubernetes'
alias kbpf='kubectl -n bpfman'

# Watch pod state transitions in real time (spot CrashLoopBackOff, Pending→Running, etc.)
alias kwatch='kubectl get pods -A -w'
alias kovnkwatch='kubectl get pods -n ovn-kubernetes -w'

# stern: concurrent log streaming across all matching pods — the right way to watch OVN-K logs.
# '.' matches every pod in the namespace; narrower patterns isolate a single component.
# stern is installed via packages_go_install (github.com/stern/stern).
command -v stern &>/dev/null && {
  alias skovnk='stern -n ovn-kubernetes .'          # all OVN-K pods at once, color-coded by pod
  alias sknode='stern -n ovn-kubernetes ovnkube-node'
  alias skctrl='stern -n ovn-kubernetes ovnkube-controller'
  alias skbpf='stern -n bpfman .'
}

# kind-load: push a locally-built image into the kind cluster without a registry round-trip.
# Needed after every 'make build' cycle when testing OVN-K or bpfman images in kind.
# Usage: kind-load <image:tag> [cluster-name]
kind-load() {
  local img="${1:?Usage: kind-load <image:tag> [cluster-name]}"
  local cluster="${2:-${KIND_CLUSTER_NAME:-kind}}"
  kind load docker-image "$img" --name "$cluster"
}
{% endif %}

