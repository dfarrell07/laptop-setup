# {{ ansible_managed }}
{% set _system = ansible_facts['system'] | default('Linux') %}

Host *
    VisualHostKey yes
    HashKnownHosts yes
    IdentitiesOnly yes
    AddKeysToAgent confirm
    ForwardAgent no
    Ciphers {{ ssh_ciphers }}
    MACs {{ ssh_macs }}
    # KexAlgorithms — intentional choices, do not auto-modify:
    # - sntrup761x25519-sha512: IETF canonical name (OpenSSH 10.0+; @openssh.com-suffixed form is a legacy alias); mlkem768x25519-sha256: 9.9+
    # - mlkem768/sntrup761: PQ-KEX, only emitted when dotfiles_ssh_kex_pq_enabled=true (probed at provision time)
    # - curve25519-sha256@libssh.org included: libssh servers (gitlab.cee.redhat.com) advertise only the @libssh.org alias;
    #   OpenSSH does not auto-expand it — both forms required for interoperability
    # - mlkem768nistp256/mlkem1024nistp384 excluded: prefer x25519-based hybrid over NIST curve classical component
    KexAlgorithms {% if dotfiles_ssh_kex_pq_enabled %}mlkem768x25519-sha256,sntrup761x25519-sha512,{% endif %}curve25519-sha256@libssh.org,curve25519-sha256
    ServerAliveInterval 60
    ServerAliveCountMax 5
    ControlMaster auto
{% if _system == 'Linux' %}
    ControlPath /run/user/%i/ssh/%r@%h-%p
{% else %}
    ControlPath ~/.ssh/sockets/%r@%h-%p
{% endif %}
    ControlPersist 600
    StrictHostKeyChecking accept-new

Host gh gist github.com gist.github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/{{ dotfiles_ssh_hardware_key_basename }}
    HostKeyAlgorithms ssh-ed25519
    # SK enforcement via IdentityFile+IdentitiesOnly rather than PubkeyAcceptedAlgorithms:
    # On Fedora-patched OpenSSH 10.2+ the crypto-policies layer intersects PubkeyAcceptedAlgorithms
    # with HostKeyAlgorithms; restricting to sk-ssh-ed25519 variants (which GitHub does not offer
    # as host key algorithms) produces an empty intersection and breaks host key negotiation.

{% if profile == 'work' %}
Host code.engineering.redhat.com
    User {{ real_user_id | default(ansible_facts['user_id'], true) }}
    IdentityFile ~/.ssh/{{ dotfiles_ssh_redhat_key_basename }}

Host gitlab.cee.redhat.com
    User git
    IdentityFile ~/.ssh/{{ dotfiles_ssh_redhat_key_basename }}
{% endif %}
{% if profile == 'work' and dotfiles_internal_git_host != '' %}

Host internal-git
    HostName {{ dotfiles_internal_git_host }}
    User git
    IdentityFile ~/.ssh/{{ dotfiles_ssh_redhat_key_basename }}
{% endif %}

{% set _ts_hosts = [dotfiles_laptop_tailscale_host, dotfiles_mac_tailscale_host] | select | list %}
{% if _ts_hosts %}
Host {{ _ts_hosts | join(' ') }}
    Port {{ ssh_port }}
    IdentityFile ~/.ssh/{{ dotfiles_ssh_hardware_key_basename }}
{% endif %}

# User-local overrides (not managed by Ansible).
# Host-specific stanzas here still take effect for hosts not covered above; SSH first-match wins per
# directive (not per block), so directives already set in Host * cannot be overridden by local includes.
# This Include is placed after Host * so local settings cannot weaken the cipher/MAC/algorithm
# policy, ForwardAgent no, StrictHostKeyChecking accept-new, or AddKeysToAgent confirm above.
Include ~/.ssh/config.local
