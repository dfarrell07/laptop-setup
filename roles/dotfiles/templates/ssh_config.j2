# {{ ansible_managed }}

Host *
    VisualHostKey yes
    HashKnownHosts yes
    IdentitiesOnly yes
    AddKeysToAgent confirm
    ForwardAgent no
    ForwardX11 no
    ForwardX11Trusted no
    Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
    KexAlgorithms {% if dotfiles_ssh_kex_pq_enabled | default(false) %}mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,{% endif %}curve25519-sha256
    ServerAliveInterval 60
    ServerAliveCountMax 5
    ControlMaster auto
{% if ansible_system | default('Linux') == 'Linux' %}
    ControlPath /run/user/%i/ssh/%r@%h-%p
{% else %}
    ControlPath ~/.ssh/sockets/%r@%h-%p
{% endif %}
    ControlPersist 600
    StrictHostKeyChecking accept-new

Host github.com gist.github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_sk
    IdentitiesOnly yes
    HostKeyAlgorithms ssh-ed25519
    PubkeyAcceptedAlgorithms sk-ssh-ed25519@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com

Host gh gist
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_sk
    IdentitiesOnly yes
    HostKeyAlgorithms ssh-ed25519
    PubkeyAcceptedAlgorithms sk-ssh-ed25519@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com

{% if profile == 'work' %}
Host code.engineering.redhat.com
    User {{ real_user_id | default(ansible_user_id) }}
    IdentityFile ~/.ssh/id_rsa_redhat
    IdentitiesOnly yes

Host gitlab.cee.redhat.com
    User git
    IdentityFile ~/.ssh/id_rsa_redhat
    IdentitiesOnly yes
{% endif %}

{% if profile == 'work' and dotfiles_internal_git_host | default('') not in ['', 'internal-git.example.com'] %}
Host internal-git
    HostName {{ dotfiles_internal_git_host }}
    User git
    IdentityFile ~/.ssh/id_rsa_redhat
    IdentitiesOnly yes
{% endif %}

{% if dotfiles_laptop_tailscale_host | default('') %}
Host {{ dotfiles_laptop_tailscale_host }}
    Port {{ ssh_port | default(722) }}
    IdentityFile ~/.ssh/id_ed25519_sk
    IdentitiesOnly yes
{% endif %}
{% if dotfiles_mac_tailscale_host | default('') %}
Host {{ dotfiles_mac_tailscale_host }}
    Port {{ ssh_port | default(722) }}
    IdentityFile ~/.ssh/id_ed25519_sk
    IdentitiesOnly yes
{% endif %}

# User-local overrides (not managed by Ansible).
# Host-specific stanzas here take effect because specific hostnames match before Host *.
# This Include is placed after Host * so local settings cannot override the cipher/MAC policy above.
Include ~/.ssh/config.local
