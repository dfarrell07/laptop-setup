# {{ ansible_managed }}
{% set _system = ansible_facts['system'] | default('Linux') %}
export PATH="$HOME/.local/bin:$HOME/bin:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.krew/bin:$PATH"
export GOPATH="$HOME/go"
export GOTMPDIR="$HOME/tmp"  # go test compiles to TempDir then exec()s — /tmp may be noexec (nosuid mount on CSB/hardened hosts)
export GOTOOLCHAIN=auto  # auto-download toolchain when go.mod requires a newer version than system Go
export KUBECONFIG="$HOME/.kube/config"
export EDITOR=vim
export VISUAL=vim
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoredups:erasedups:ignorespace
shopt -s histappend
export REGISTRY_AUTH_FILE="$HOME/.config/containers/auth.json"
export DIRENV_LOG_FORMAT=""  # suppress verbose 'direnv: loading .envrc' output on every cd
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
command -v rg &>/dev/null && export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git"'
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
{% if _system == 'Linux' %}
export TMUX_TMPDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/tmux"
[[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]] && export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
export KIND_EXPERIMENTAL_PROVIDER=podman  # use rootless Podman provider (not docker-provider-via-socket)
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket}"
{% else %}
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$HOME/.ssh/ssh-agent.socket}"
{% endif %}
{% if profile == 'work' %}
{% if dotfiles_aws_profile %}
export AWS_PROFILE='{{ dotfiles_aws_profile | replace("'", "'\''" ) }}'
{% endif %}
{% if dotfiles_gonosumdb %}
export GONOSUMDB='{{ dotfiles_gonosumdb | replace("'", "'\''" ) }}'
{% endif %}
{% if dotfiles_goprivate %}
export GOPRIVATE='{{ dotfiles_goprivate | replace("'", "'\''" ) }}'
{% endif %}
{% endif %}

command -v direnv &>/dev/null && eval "$(direnv hook bash)"
command -v zoxide &>/dev/null && eval "$(zoxide init bash)"

umask 077
{% if profile == 'work' %}

# Claude Code Vertex backend (env.sh holds ANTHROPIC_VERTEX_PROJECT_ID — not in repo)
[ -f "${HOME}/.config/claude-code-vertex/env.sh" ] && . "${HOME}/.config/claude-code-vertex/env.sh"
{% endif %}
