#!/bin/sh
# git credential helper for https://github.com: hands out gh's token only for the owner's repositories
# (github.com/<github.user>/<repo>) and for the read allowlist (~/.config/git/github-https-read, one owner/repo per
# line: private repositories of other owners fetched over HTTPS; the pre-push hook still refuses token pushes to them).
# Any other path gets no credentials, so a push to an upstream repository cannot use the token even where the
# pre-push hook does not run (a repository with its own core.hooksPath). Needs credential.useHttpPath.
# Usage (gitconfig): helper = !sh ~/.config/git/gh-credential <path to gh>
set -eu
_gh=$1; _op=${2:-}
[ "$_op" = get ] || exit 0  # store/erase: gh keeps its own token
_input=$(cat)
_field() { printf '%s\n' "$_input" | sed -n "s/^$1=//p" | head -n 1; }
[ "$(_field protocol)" = https ] && [ "$(_field host)" = github.com ] || exit 0
_path=$(_field path | tr '[:upper:]' '[:lower:]'); _path=${_path%/}; _path=${_path%.git}
_me=$(git config --global --get github.user | tr '[:upper:]' '[:lower:]') || exit 0
printf '%s' "$_path" | grep -Eqx '[a-z0-9_-]+/[a-z0-9_.-]+' || exit 0  # no empty, dot-only or encoded segment
case "${_path#*/}" in .|..) exit 0;; esac
_allowed=no
[ -n "$_me" ] && [ "${_path%%/*}" = "$_me" ] && _allowed=yes
_list="${XDG_CONFIG_HOME:-$HOME/.config}/git/github-https-read"
[ "$_allowed" = no ] && [ -f "$_list" ] && tr '[:upper:]' '[:lower:]' < "$_list" | grep -Fqx "$_path" && _allowed=yes
[ "$_allowed" = yes ] || exit 0
printf '%s\n' "$_input" | "$_gh" auth git-credential get
