#!/bin/sh
# Chain to per-repo pre-push hook if one exists (core.hooksPath replaces .git/hooks/ lookup). Positional args and stdin are forwarded to the per-repo hook (stdin through a pipe).
_repo_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-push"
_stdin=$(cat)
# HTTPS pushes (gh's token, no YubiKey) go only to github.com/<github.user>/; anything else on GitHub must use SSH.
# The gitconfig rewrites take care of that, but an explicit remote pushurl skips pushInsteadOf, so check the real URL.
# git runs this after it has read the remote's refs, so it stops the push, not the connection. The credential helper
# (~/.config/git/gh-credential) is the guard that also holds where this hook does not run.
_url=$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')
# <transport>::<address> (https::https://github.com/...): strip only a leading transport name
_url=$(printf '%s' "$_url" | sed -E 's#^[a-z0-9+.-]+::##')
case "$_url" in http://*|https://*)
  _rest=${_url#*://}
  _host=${_rest%%/*}; _host=${_host##*@}; _host=${_host%%:*}; _host=${_host%.}; _host=${_host#www.}
  case "$_host" in *%*)  # git and curl decode an escaped host (github%2ecom) before the credential lookup
    printf 'pre-push: refusing an HTTPS push to a percent-encoded host (%s)\n' "$_host" >&2
    exit 1
  esac
  if [ "$_host" = github.com ]; then
    # Only a plain <owner>/<repo> path: no empty, dot or percent-encoded segment can walk to another owner.
    _path=${_rest#*/}; _path=${_path%/}; _owner=${_path%%/*}; _repo=${_path#*/}
    _me=$(git config --global --get github.user | tr '[:upper:]' '[:lower:]')
    if [ -z "$_me" ] || [ "$_owner" != "$_me" ] || ! printf '%s' "$_repo" | grep -Eqx '[a-z0-9_.-]+' \
      || [ "$_repo" = . ] || [ "$_repo" = .. ]; then
      printf 'pre-push: refusing an HTTPS push to github.com/%s: only github.com/%s/<repo> takes token pushes; use git pushsk (SSH)\n' \
        "$_path" "${_me:-<github.user unset>}" >&2
      exit 1
    fi
  fi
esac
printf '%s\n' "$_stdin" | while IFS=' ' read -r _lref _lsha _rref _rsha; do
  case "$_rref" in refs/heads/main|refs/heads/master)
    [ "$_rsha" != "0000000000000000000000000000000000000000" ] && ! git merge-base --is-ancestor "$_rsha" "$_lsha" 2>/dev/null && printf 'WARNING: force push to %s\n' "$_rref" >&2
  esac
done
if [ -x "$_repo_hook" ]; then
  printf '%s\n' "$_stdin" | "$_repo_hook" "$@"
  exit $?
fi
