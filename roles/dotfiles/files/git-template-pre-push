#!/bin/sh
# Chain to per-repo pre-push hook if one exists (core.hooksPath replaces .git/hooks/ lookup).
# Positional args and stdin are forwarded to the per-repo hook via exec.
_repo_hook="$(git rev-parse --git-dir 2>/dev/null)/hooks/pre-push"
if [ -f "$_repo_hook" ]; then
  exec "$_repo_hook" "$@"
fi
