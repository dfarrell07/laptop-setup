#!/bin/bash
# Global commit-msg hook (core.hooksPath): chains the repository's own hook, requires Signed-off-by.
# Run the repository's own commit-msg hook first (core.hooksPath replaces the .git/hooks
# lookup, so DCO/Change-Id hooks would otherwise be skipped silently); it may edit "$1".
_repo_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/commit-msg"
if [ -x "$_repo_hook" ]; then
  "$_repo_hook" "$@" || exit $?
fi
# Merge commits (including conflict-resolution commits) are not sign-off checked; git merge --signoff still adds one.
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
# Require Signed-off-by (enforce 'git commit -s') — checked before any early-exit so reverts are also covered
if ! grep -q '^Signed-off-by:' "$1"; then
  echo "ERROR: Missing Signed-off-by — use --signoff / -s with your git command" >&2
  exit 1
fi
# Subject style (scope, tense, length) is a per-repository convention: this hook runs in
# every repository via core.hooksPath, so it only enforces sign-off. laptop-setup's own style
# rules live in its .githooks/commit-msg (make hooks), and other repos keep their own.
exit 0
