#!/bin/bash
# Global commit-msg hook (core.hooksPath): chains the repository's own hook, requires Signed-off-by.
# Run the repository's own commit-msg hook first (core.hooksPath replaces the .git/hooks
# lookup, so DCO/Change-Id hooks would otherwise be skipped silently); it may edit "$1".
# The repo's own hook: <repo>/<laptop.repoHooks>/commit-msg when the git_repos role opted the repo in (repos.yml
# hooks: true; a local setting repo content cannot make), else .git/hooks/commit-msg.
_repo_hooks_dir=$(git config --local --get laptop.repoHooks 2>/dev/null || true)
case "$_repo_hooks_dir" in
  ""|/*|*..*) _repo_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/commit-msg" ;;
  *) _repo_hook="$(git rev-parse --show-toplevel 2>/dev/null)/$_repo_hooks_dir/commit-msg" ;;
esac
if [ -x "$_repo_hook" ]; then
  "$_repo_hook" "$@" || exit $?
fi
# Merge commits (including conflict-resolution commits) are not sign-off checked; git merge --signoff still adds one.
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
# Throwaway repositories that test suites create in temp directories commit without sign-off; requiring it there
# breaks their tests. Only the sign-off rule is skipped: gitleaks and the pre-push guard still run everywhere.
_top=$(git rev-parse --show-toplevel 2>/dev/null || true)
# Fixed system temp paths only (macOS's TMPDIR is under /var/folders): a TMPDIR pointing at a broad directory such as
# ~/tmp would otherwise switch the rule off for real repositories there.
# A throwaway repository also has no remote: agent worktrees under /tmp are real clones and keep the rule.
case "$_top" in
  /tmp/*|/var/tmp/*|/private/tmp/*|/private/var/folders/*|/var/folders/*) [ -n "$(git remote 2>/dev/null)" ] || exit 0 ;;
esac
# Require Signed-off-by (enforce 'git commit -s') — checked before any early-exit so reverts are also covered
if ! grep -q '^Signed-off-by:' "$1"; then
  echo "ERROR: Missing Signed-off-by — use --signoff / -s with your git command" >&2
  exit 1
fi
# Subject style (scope, tense, length) is a per-repository convention: this hook runs in
# every repository via core.hooksPath, so it only enforces sign-off. laptop-setup's own style
# rules live in its .githooks/commit-msg (make hooks), and other repos keep their own.
exit 0
