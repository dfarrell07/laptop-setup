#!/bin/sh
# Global pre-commit (core.hooksPath): the repository's own hook first (it may stage files, such as formatter output),
# then a gitleaks scan of everything staged. Either failing blocks the commit.
# Use '# gitleaks:allow' on a line to suppress a false positive.
# The repo's own hook: <repo>/<laptop.repoHooks>/pre-commit when the git_repos role opted the repo in (repos.yml
# hooks: true; a local setting repo content cannot make), else .git/hooks/pre-commit.
_repo_hooks_dir=$(git config --local --get laptop.repoHooks 2>/dev/null || true)
case "$_repo_hooks_dir" in
  ""|/*|*..*) _repo_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-commit" ;;
  *) _repo_hook="$(git rev-parse --show-toplevel 2>/dev/null)/$_repo_hooks_dir/pre-commit" ;;
esac
# A repository whose own core.hooksPath points at that directory runs its hooks itself (and they may call this global
# hook): chaining back into them would loop, so the chain is skipped. git resolves the hooks directory it runs from
# (core.hooksPath in any form, bare repositories); no environment variable can switch this off.
_hooks_path=$(git rev-parse --git-path hooks 2>/dev/null || true)
if [ -n "$_hooks_path" ] && [ -d "$_hooks_path" ] &&
  [ "$(cd "$_hooks_path" && pwd -P)" = "$(cd "$(dirname "$_repo_hook")" 2>/dev/null && pwd -P)" ]; then
  _repo_hook=""
fi
if [ -x "$_repo_hook" ]; then
  "$_repo_hook" || exit $?
fi
if command -v gitleaks >/dev/null 2>&1; then
  set --; [ -f .gitleaks.toml ] && set -- --config .gitleaks.toml; gitleaks git --pre-commit --staged --redact --max-decode-depth 2 "$@"
  exit $?
fi
# Missing tool (fresh machine, offline provision) warns: blocking every commit in every repo
# until provisioning finishes is worse; a leak gitleaks does find still blocks.
echo "WARNING: gitleaks not found — staged changes were NOT scanned for secrets; install via ~/laptop-setup: make bootstrap-hooks" >&2
exit 0
