#!/bin/sh
# Use '# gitleaks:allow' on a line to suppress a false positive
_gitleaks_rc=0
if command -v gitleaks >/dev/null 2>&1; then
  set --; [ -f .gitleaks.toml ] && set -- --config .gitleaks.toml; gitleaks git --pre-commit --staged --redact --max-decode-depth 2 "$@"
  _gitleaks_rc=$?
else
  # Missing tool (fresh machine, offline provision) warns: blocking every commit in every repo
  # until provisioning finishes is worse; a leak gitleaks does find still blocks.
  echo "WARNING: gitleaks not found — staged changes were NOT scanned for secrets; install via ~/laptop-setup: make bootstrap-hooks" >&2
fi
# Chain to per-repo hook if one exists (core.hooksPath replaces .git/hooks/ lookup).
# Per-repo hook failure blocks the commit; gitleaks failure also blocks even if per-repo hook passes.
_repo_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-commit"
if [ -x "$_repo_hook" ]; then
  "$_repo_hook" || exit $?
fi
exit $_gitleaks_rc
