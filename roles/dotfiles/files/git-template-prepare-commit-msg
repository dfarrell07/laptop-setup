#!/bin/sh
# Chain to per-repo prepare-commit-msg hook if one exists (core.hooksPath replaces .git/hooks/ lookup).
# Positional args and stdin are forwarded to the per-repo hook via exec.
# The repo's own hook: <repo>/<laptop.repoHooks>/prepare-commit-msg when the git_repos role opted the repo in (repos.yml
# hooks: true; a local setting repo content cannot make), else .git/hooks/prepare-commit-msg.
_repo_hooks_dir=$(git config --local --get laptop.repoHooks 2>/dev/null || true)
case "$_repo_hooks_dir" in
  ""|/*|*..*) _repo_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/prepare-commit-msg" ;;
  *) _repo_hook="$(git rev-parse --show-toplevel 2>/dev/null)/$_repo_hooks_dir/prepare-commit-msg" ;;
esac
# A repository whose own core.hooksPath points at that directory runs its hooks itself (and they may call this global
# hook): chaining back into them would loop, so the chain is skipped. No environment variable can switch this off.
_hooks_path=$(git config --get core.hooksPath 2>/dev/null || true)
case "$_hooks_path" in
  "") ;;
  "~"/*) _hooks_path="$HOME/${_hooks_path#\~/}" ;;
  /*) ;;
  *) _hooks_path="$(git rev-parse --show-toplevel 2>/dev/null)/$_hooks_path" ;;
esac
if [ -n "$_hooks_path" ] && [ -d "$_hooks_path" ] &&
  [ "$(cd "$_hooks_path" && pwd -P)" = "$(cd "$(dirname "$_repo_hook")" 2>/dev/null && pwd -P)" ]; then
  _repo_hook=""
fi
if [ -x "$_repo_hook" ]; then
  exec "$_repo_hook" "$@"
fi
