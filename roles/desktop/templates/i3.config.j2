# {{ ansible_managed }}

set $mod Mod4
set $term {{ desktop_terminal }}

font pango:{{ desktop_wm_font_family }} {{ desktop_wm_font_size }}

# Autostart
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -c {{ desktop_wm_lock_color }}
exec --no-startup-id xautolock -time {{ (desktop_wm_idle_lock_timeout | int // 60) }} -locker 'i3lock -c {{ desktop_wm_lock_color }}'
exec --no-startup-id xset dpms 0 0 {{ desktop_wm_idle_display_timeout }}
exec --no-startup-id xset r rate {{ desktop_wm_repeat_delay }} {{ desktop_wm_repeat_rate }}
exec --no-startup-id dunst
exec --no-startup-id {{ desktop_i3_polkit_agent }}  # polkit-gnome removed Fedora 41+
exec --no-startup-id clipit -n  # clipboard manager daemon — persists clipboard content after source app closes
exec_always --no-startup-id nm-applet
exec_always --no-startup-id autorandr --change

# Floating window drag/resize with mouse
floating_modifier $mod

# Terminal
bindsym $mod+Return exec $term

# Kill window
bindsym $mod+Shift+q kill

# Launcher
bindsym $mod+d exec dmenu_run
bindsym $mod+Shift+d exec arandr

{% include '_focus_move.j2' %}

# Split
bindsym $mod+b split h
bindsym $mod+v split v

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

{% include '_workspaces.j2' %}

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Audio (PipeWire via wpctl; -l 1.0 caps raise at 100% — same as Sway config)
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Media keys (playerctl)
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioStop exec --no-startup-id playerctl stop

# Brightness
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Browser (uses same variable as Sway: desktop_wm_browser)
bindsym $mod+Shift+b exec {{ desktop_wm_browser }}

# Manual screen lock ($mod+l is taken by focus-right)
bindsym $mod+Ctrl+l exec --no-startup-id i3lock -c {{ desktop_wm_lock_color }}

# Screenshot (scrot for X11)
bindsym Print exec --no-startup-id scrot ~/Pictures/screenshot-%F-%H-%M-%S.png
bindsym $mod+Print exec --no-startup-id scrot -s ~/Pictures/screenshot-%F-%H-%M-%S.png

# Session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# Appearance
default_border pixel {{ desktop_wm_border_width }}
default_floating_border pixel {{ desktop_wm_floating_border_width }}
{% if desktop_wm_hide_edge_borders | length > 0 %}hide_edge_borders {{ desktop_wm_hide_edge_borders }}{% endif %}

# Status bar
{% include '_bar_colors.j2' %}
