# {{ ansible_managed }}
# The Linux sshd policy (roles/system/templates/sshd-hardening.conf.j2) where it applies to macOS: keys only (ed25519
# and FIDO2), no root, only this user and here only from tailnet addresses (desktop_macos_ssh_allow_from), the same
# limits and algorithms. Read before 100-macos.conf; sshd keeps the first value it sees.
{# The play keeps the algorithms this Mac's OpenSSH supports (_desktop_sshd_algorithms); without it, the full lists #}
{% set _alg = _desktop_sshd_algorithms | default({
     'KexAlgorithms': ssh_kex_algorithms.split(','), 'Ciphers': ssh_ciphers.split(','), 'MACs': ssh_macs.split(','),
     'HostKeyAlgorithms': ssh_host_key_algorithms.split(','), 'PubkeyAcceptedAlgorithms': ssh_pubkey_accepted_algorithms}) %}
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
HostbasedAuthentication no
GSSAPIAuthentication no
AuthenticationMethods publickey
PubkeyAcceptedAlgorithms {{ _alg['PubkeyAcceptedAlgorithms'] | map('regex_replace', '[\r\n].*', '') | join(',') }}
PermitRootLogin no
PermitUserEnvironment no
AuthorizedKeysFile .ssh/authorized_keys
AllowUsers {% for net in desktop_macos_ssh_allow_from %}{{ ansible_facts['user_id'] }}@{{ net }}{{ ' ' if not loop.last }}{% endfor %}

MaxAuthTries 3
MaxSessions {{ desktop_macos_ssh_max_sessions | int }}
LoginGraceTime 30
# No MaxStartups: launchd accepts each connection and starts one sshd -i for it, so no sshd sees concurrent
# unauthenticated connections and the limit never applies.

ClientAliveInterval {{ desktop_macos_ssh_client_alive_interval | int }}
ClientAliveCountMax {{ desktop_macos_ssh_client_alive_count_max | int }}
{% if desktop_macos_ssh_unused_connection_timeout | int %}
UnusedConnectionTimeout {{ desktop_macos_ssh_unused_connection_timeout | int }}
{% endif %}
TCPKeepAlive no

X11Forwarding no
{# an unquoted yes/no in config.yml is a YAML boolean: sshd takes the word, not True/False #}
AllowAgentForwarding {{ ('yes' if desktop_macos_ssh_allow_agent_forwarding is sameas true else 'no' if desktop_macos_ssh_allow_agent_forwarding is sameas false else desktop_macos_ssh_allow_agent_forwarding) | regex_replace('[\r\n].*', '') }}
AllowTcpForwarding {{ ('yes' if desktop_macos_ssh_allow_tcp_forwarding is sameas true else 'no' if desktop_macos_ssh_allow_tcp_forwarding is sameas false else desktop_macos_ssh_allow_tcp_forwarding) | regex_replace('[\r\n].*', '') }}
LogLevel VERBOSE

HostKeyAlgorithms {{ _alg['HostKeyAlgorithms'] | map('regex_replace', '[\r\n].*', '') | join(',') }}
Ciphers {{ _alg['Ciphers'] | map('regex_replace', '[\r\n].*', '') | join(',') }}
MACs {{ _alg['MACs'] | map('regex_replace', '[\r\n].*', '') | join(',') }}
KexAlgorithms {{ _alg['KexAlgorithms'] | map('regex_replace', '[\r\n].*', '') | join(',') }}
RekeyLimit {{ desktop_macos_ssh_rekey_limit | regex_replace('[\r\n].*', '') }}
Compression no
