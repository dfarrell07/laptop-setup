# {{ ansible_managed }}
# Re-runs replace hand edits (the previous file is kept beside it as aerospace.toml.<timestamp>~): change the
# template (roles/desktop/templates/aerospace.toml.j2) or its desktop_* variables instead.
# AeroSpace — i3-inspired tiling WM for macOS. Bindings follow the sway config (sway.config.j2) with
# alt as the mod key: focus/move on hjkl, workspaces 1-10, i3 splits and layouts, no gaps. These alt chords are
# global, so terminals no longer receive them (readline alt-b/alt-f, alt-<digit>).

config-version = 2

# Registers AeroSpace as a login item, so the tiling layout returns after a reboot or power loss
start-at-login = true

# i3 has no hidden windows: an app hidden with cmd-h comes back, so it never leaves a hole in the layout
automatically-unhide-macos-hidden-apps = true

after-login-command = []
after-startup-command = []
{% if _desktop_macos_bar_on | bool %}

# The bar (sketchybarrc.j2) follows the focused workspace, windows moving between workspaces and the binding mode
{% set _sketchybar = ansible_facts['user_dir'] ~ '/.local/bin/sketchybar' %}
exec-on-workspace-change = ['{{ _sketchybar }}', '--trigger', 'aerospace_workspace_change']
on-focus-changed = ['exec-and-forget {{ _sketchybar }} --trigger aerospace_workspace_change']
on-mode-changed = ['exec-and-forget {{ _sketchybar }} --trigger aerospace_mode_change']
{% endif %}

# Off, as in AeroSpace's i3-like preset: with flattening on, alt-b/alt-v splits have no effect
enable-normalization-flatten-containers = false
enable-normalization-opposite-orientation-for-nested-containers = false

accordion-padding = 30
default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'

# sway: gaps inner/outer {{ desktop_sway_gaps_inner | int }}/{{ desktop_sway_gaps_outer | int }}
[gaps]
inner.horizontal = {{ desktop_sway_gaps_inner | int }}
inner.vertical = {{ desktop_sway_gaps_inner | int }}
outer.left = {{ desktop_sway_gaps_outer | int }}
outer.bottom = {{ desktop_sway_gaps_outer | int }}
outer.top = {{ desktop_sway_gaps_outer | int + (desktop_macos_bar_height | int if _desktop_macos_bar_on | bool else 0) }}  # plus the bar's height
outer.right = {{ desktop_sway_gaps_outer | int }}

[mode.main.binding]
alt-enter = 'exec-and-forget open -na {{ desktop_macos_terminal_app }}'
alt-shift-q = 'close'
alt-shift-c = 'reload-config'
# sway $mod+Shift+d (wdisplays): the Displays settings
alt-shift-d = 'exec-and-forget open "x-apple.systempreferences:com.apple.Displays-Settings.extension"'
# sway $mod+d (wofi drun): pick an app with choose (brew choose-gui) and open it
alt-d = 'exec-and-forget ls /Applications /Applications/Utilities /System/Applications /System/Applications/Utilities "$HOME/Applications" 2>/dev/null | sed -n "s/\\.app$//p" | sort -u | {{ dotfiles_homebrew_prefix }}/bin/choose | { IFS= read -r app; [ -n "$app" ] && open -a "$app"; }'
# sway $mod+Ctrl+l (swaylock): the macOS lock shortcut via System Events, after the held keys are released.
# First use prompts to let AeroSpace control System Events (Privacy & Security > Automation).
alt-ctrl-l = 'exec-and-forget sleep 0.4; osascript -e "tell application \"System Events\" to keystroke \"q\" using {control down, command down}"'

# Focus wraps at the workspace edge, as in sway
alt-h = 'focus --boundaries-action wrap-around-the-workspace left'
alt-j = 'focus --boundaries-action wrap-around-the-workspace down'
alt-k = 'focus --boundaries-action wrap-around-the-workspace up'
alt-l = 'focus --boundaries-action wrap-around-the-workspace right'
alt-shift-h = 'move left'
alt-shift-j = 'move down'
alt-shift-k = 'move up'
alt-shift-l = 'move right'

# i3/sway splits and layouts: b/v split, s stacking, w tabbed, e toggle split
alt-b = 'split horizontal'
alt-v = 'split vertical'
alt-s = 'layout v_accordion'
alt-w = 'layout h_accordion'
alt-e = 'layout tiles horizontal vertical'
alt-f = 'fullscreen'
alt-shift-space = 'layout floating tiling'

alt-1 = 'workspace 1'
alt-2 = 'workspace 2'
alt-3 = 'workspace 3'
alt-4 = 'workspace 4'
alt-5 = 'workspace 5'
alt-6 = 'workspace 6'
alt-7 = 'workspace 7'
alt-8 = 'workspace 8'
alt-9 = 'workspace 9'
alt-0 = 'workspace 10'
alt-shift-1 = 'move-node-to-workspace 1'
alt-shift-2 = 'move-node-to-workspace 2'
alt-shift-3 = 'move-node-to-workspace 3'
alt-shift-4 = 'move-node-to-workspace 4'
alt-shift-5 = 'move-node-to-workspace 5'
alt-shift-6 = 'move-node-to-workspace 6'
alt-shift-7 = 'move-node-to-workspace 7'
alt-shift-8 = 'move-node-to-workspace 8'
alt-shift-9 = 'move-node-to-workspace 9'
alt-shift-0 = 'move-node-to-workspace 10'

# Scratchpad stand-in: a workspace named S (AeroSpace has no floating scratchpad)
alt-minus = 'workspace S'
alt-shift-minus = 'move-node-to-workspace S'

alt-tab = 'workspace-back-and-forth'
alt-shift-tab = 'move-workspace-to-monitor --wrap-around next'
alt-r = 'mode resize'

[mode.resize.binding]
h = 'resize width -50'
j = 'resize height +50'
k = 'resize height -50'
l = 'resize width +50'
enter = 'mode main'
esc = 'mode main'
