#!/bin/bash
# {{ ansible_managed }}
# Bar status_command: runs i3status and rewrites each update. Drops the GiB unit from RAM, shortens disk units
# (893.1G), adds watts to the battery while discharging, and adds fields i3status cannot produce: REBOOT (a core
# package is newer than the boot), UPD (an automatic update job failed), CSB FAIL (IT's last compliance run failed),
# STALL (memory pressure), MIC (the default microphone: muted, or on in yellow), CTR (running rootless Podman
# containers), AI (interactive agent sessions) and, with desktop_i3status_vpn, one block per configured VPN (up, down
# or missing) plus active NetworkManager VPNs.
set -u
show_vpn={{ desktop_i3status_vpn | bool | ternary('1', '0') }}
# VPNs (NetBird on CSB, Tailscale, desktop_i3status_vpns_extra): names, status commands, the regex that means connected
{% set _vpns = desktop_i3status_vpns if desktop_i3status_vpn | bool else [] %}
vpn_names=({% for v in _vpns %}{{ v.name | quote }} {% endfor %})
vpn_connected=({% for v in _vpns %}{{ v.connected | quote }} {% endfor %})
{% for v in _vpns %}
vpn_cmd_{{ loop.index0 }}=({{ v.command | map('quote') | join(' ') }})
{% endfor %}
battery=/sys/class/power_supply/BAT{{ desktop_i3status_battery_num | string | regex_replace('[^0-9]', '') }}
{% raw %}
red='#FF0000'
green='#00FF00'
yellow='#FFFF00'
# Packages whose update only takes effect after a reboot (the set dnf needs-restarting -r checks, trimmed)
reboot_pkgs=(kernel-core glibc systemd dbus-broker linux-firmware microcode_ctl)
boot_time=$(awk '/^btime/ {print $2}' /proc/stat)

field() { # name text [color]
  if (($# > 2)); then
    printf '{"name":"%s","full_text":"%s","color":"%s"}' "$1" "$2" "$3"
  else
    printf '{"name":"%s","full_text":"%s"}' "$1" "$2"
  fi
}

# One block per configured VPN, always shown: up (green), down, or missing (its command is not installed). The
# commands run at most every 15 s (a status call can take half a second; the bar updates every few seconds), so
# this sets vpn_cache instead of printing: a $(...) subshell would lose the cache.
vpn_cache=
vpn_cache_at=-100
vpn_fields() {
  if ((SECONDS - vpn_cache_at >= 15)); then
    local i out fields= n t nm=()
    for i in "${!vpn_names[@]}"; do
      local -n cmd="vpn_cmd_$i"
      out=
      if ! command -v "${cmd[0]}" >/dev/null; then
        fields+="$(field "vpn$i" "${vpn_names[i]} missing" "$yellow"),"
      elif out=$(timeout -k 1 2 "${cmd[@]}" 2>/dev/null || true) &&  # a VPN that is down may exit non-zero
        grep -Eq -- "${vpn_connected[i]}" <<<"$out"; then
        fields+="$(field "vpn$i" "${vpn_names[i]} up" "$green"),"
      else
        fields+="$(field "vpn$i" "${vpn_names[i]} down"),"
      fi
      unset -n cmd
    done
    while IFS=: read -r n t; do
      case "$t" in vpn | wireguard) nm+=("${n//[\"\\]/}") ;; esac
    done < <(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null)
    if ((${#nm[@]})); then
      local IFS=,
      fields+="$(field vpn "VPN ${nm[*]}" "$green"),"
    fi
    vpn_cache=$fields
    vpn_cache_at=$SECONDS
  fi
}

# Interactive agent sessions: terminals (tmux panes included) running a claude, codex or agy process, each
# terminal counted once so helper processes a session starts on its own terminal do not inflate the count. Codex
# leaves app-server daemons running after a session ends; they have no terminal and are not counted.
agent_sessions() {
  ps -eo tty=,comm= 2>/dev/null |
    awk '$1 != "?" && $2 ~ /^(claude|codex|agy)$/ && !seen[$1]++ {n++} END {print n + 0}'
}

# Automatic update jobs; UPD shows while any of them is in the failed state (journalctl -u / --user -u <unit>).
update_units=(dnf5-automatic.service dnf-automatic.service flatpak-update.service fwupd-refresh.service
  aide-rebaseline.service)
user_update_units=(laptop-user-update.service)
updates_failed() {
  systemctl is-failed --quiet "${update_units[@]}" 2>/dev/null ||
    systemctl --user is-failed --quiet "${user_update_units[@]}" 2>/dev/null
}

reboot_needed() {
  command -v rpm >/dev/null || return 1
  local newest
  newest=$(rpm -q --qf '%{INSTALLTIME}\n' "${reboot_pkgs[@]}" 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -1)
  [[ -n $newest ]] && ((newest > boot_time))
}

# Patterns live in variables: quotes inside [[ =~ ]] are shell quoting, not literal characters
mem_re='\{"name":"memory"[^}]*\}'
disk_re='\{"name":"disk_info"[^}]*\}'
bat_re='\{"name":"battery"[^}]*"full_text":"([^"]*)"[^}]*\}'
vol_re='\{"name":"volume"[^}]*\}'

tick=0
containers=
reboot=
upd_failed=
i3status --config "$HOME/.config/i3status/config" | {
  # i3bar protocol: a version header and the opening "[", then one JSON array per update (every 5 s)
  IFS= read -r line && printf '%s\n' "$line"
  IFS= read -r line && printf '%s\n' "$line"
  while IFS= read -r line; do
    prefix=
    [[ $line == ,* ]] && prefix=, && line=${line#,}

    # Slower checks: containers every 30 s, reboot state every minute
    if ((tick % 6 == 0)) && command -v podman >/dev/null; then
      containers=$(($(podman ps -q 2>/dev/null | wc -l)))  # arithmetic drops BSD wc padding
    fi
    if ((tick % 12 == 0)); then
      reboot=
      reboot_needed && reboot=1
      upd_failed=
      updates_failed && upd_failed=1
    fi
    tick=$((tick + 1))

    # Alerts first, shown only when something needs attention
    lead=
    [[ -n $reboot ]] && lead+="$(field reboot REBOOT "$red"),"
    [[ -n $upd_failed ]] && lead+="$(field updates UPD "$red"),"
    grep -qs '"status": "failed"' /run/csb_ansible_compliance.json && lead+="$(field csb 'CSB FAIL' "$red"),"
    [[ -n $lead ]] && line="[${lead}${line#[}"

    # RAM without units, followed by STALL when tasks wait on memory over 5% of the last 10 s
    if [[ $line =~ $mem_re ]]; then
      blk=${BASH_REMATCH[0]}
      new=${blk// GiB/}
      avg10=avg10=0
      { read -r _ avg10 _ </proc/pressure/memory; } 2>/dev/null
      stall=${avg10#avg10=}
      stall=${stall%.*}
      ((${stall:-0} >= 5)) && new+=",$(field stall "STALL ${stall}%" "$red")"
      line=${line/"$blk"/"$new"}
    fi

    rest=$line
    while [[ $rest =~ $disk_re ]]; do
      blk=${BASH_REMATCH[0]}
      new=${blk// TiB/T}
      new=${new// GiB/G}
      new=${new// MiB/M}
      line=${line/"$blk"/"$new"}
      rest=${rest#*"$blk"}
    done

    # Battery power draw while discharging
    if [[ $line =~ $bat_re ]] && [[ $(cat "$battery/status" 2>/dev/null) == Discharging ]]; then
      blk=${BASH_REMATCH[0]}
      text=${BASH_REMATCH[1]}
      watts=$(($(cat "$battery/power_now" 2>/dev/null || echo 0) / 1000000))
      new=${blk/"\"$text\""/"\"${text% } ${watts}W\""}
      line=${line/"$blk"/"$new"}
    fi

    # MIC right after VOL: the default microphone's mute state (i3status's volume module follows outputs only).
    # No field when there is no input device; XF86AudioMicMute toggles it.
    if [[ $line =~ $vol_re ]] && command -v wpctl >/dev/null; then
      mic=$(timeout 2 wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null) || mic=
      if [[ $mic == Volume:* ]]; then
        blk=${BASH_REMATCH[0]}
        if [[ $mic == *MUTED* ]]; then micf=$(field mic 'MIC muted'); else micf=$(field mic 'MIC on' "$yellow"); fi
        line=${line/"$blk"/"$blk,$micf"}
      fi
    fi

    # CTR, AI and VPN go before the Wi-Fi field (or at the end)
    tail_fields=
    [[ -n $containers ]] && tail_fields+="$(field containers "CTR $containers"),"
    tail_fields+="$(field agents "AI $(agent_sessions)"),"
    if ((show_vpn)); then vpn_fields; tail_fields+=$vpn_cache; fi
    if [[ $line == *'{"name":"wireless"'* ]]; then
      line=${line/'{"name":"wireless"'/"$tail_fields"'{"name":"wireless"'}
    else
      line="${line%]},${tail_fields%,}]"
    fi
    printf '%s%s\n' "$prefix" "$line"
  done
}
{% endraw %}
