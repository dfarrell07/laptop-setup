# {{ ansible_managed }}
{% set _mounts = ansible_facts['mounts'] | default([]) %}
{% set _root_dev = _mounts | selectattr('mount', 'equalto', '/') | map(attribute='device') | first | default('') %}
{% set _home_dev = _mounts | selectattr('mount', 'equalto', '/home') | map(attribute='device') | first | default('') %}
{# /home gets its own block only on a separate filesystem; btrfs subvolumes share the device and free space #}
{% set _desktop_separate_home = _home_dev != '' and _home_dev != _root_dev %}
{# Wired field only when a wired NIC (en*) exists; otherwise it is an always-empty slot #}
{% set _desktop_has_wired = ansible_facts['interfaces'] | default([]) | select('match', '^en') | list | length > 0 %}

general {
    colors = true
    interval = 5
    output_format = "i3bar"  # explicit: under the VPN wrapper the parent is bash, not the bar
}

order += "cpu_usage"
order += "load"
{% if desktop_i3status_cpu_temp_path %}
order += "cpu_temperature 0"
{% endif %}
order += "memory"
order += "disk /"
{% if _desktop_separate_home %}
order += "disk /home"
{% endif %}
{% if desktop_i3status_battery_num != '' %}
order += "battery {{ desktop_i3status_battery_num | string | regex_replace('[^0-9]', '') }}"
{% endif %}
order += "volume master"
order += "time"
{% for z in desktop_i3status_timezones %}
order += "tztime team{{ loop.index }}"
{% endfor %}
{% if _desktop_has_wired %}
order += "ethernet _first_"
{% endif %}
order += "wireless _first_"

cpu_usage {
    format = "CPU %usage"
    max_threshold = 80
}

{% if desktop_i3status_cpu_temp_path %}
# AMD k10temp via configurable hwmon path. i3status cpu_temperature requires a concrete path (no globs).
# Override desktop_i3status_cpu_temp_path in config.yml for different PCI topologies.
# Example: /sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon8/temp1_input (ThinkPad P16v Gen 1 AMD k10temp)
cpu_temperature 0 {
    format = "%degrees°C"
    path = "{{ desktop_i3status_cpu_temp_path | regex_replace('[^/a-zA-Z0-9._:-]', '') }}"
    max_threshold = 90
}
{% endif %}

load {
    format = "LOAD %1min %5min %15min"
    max_threshold = "{{ ansible_facts['processor_vcpus'] | default(4) | int }}"  # red above one task per CPU
}

memory {
    format = "RAM %used/%total"
    threshold_degraded = "10%"
    format_degraded = "RAM LOW %available free"
}

disk "/" {
    format = "DISK %avail"
    prefix_type = si
    low_threshold = 10
}

{% if _desktop_separate_home %}
disk "/home" {
    format = "HOME %avail"
    low_threshold = 20
    prefix_type = si
}
{% endif %}

{% if desktop_i3status_battery_num != '' %}
battery {{ desktop_i3status_battery_num | string | regex_replace('[^0-9]', '') }} {
    format = "BAT %status%percentage %remaining"
    integer_battery_capacity = true
    last_full_capacity = true
    status_chr = "⚡"
    status_bat = ""
    status_full = ""
}
{% endif %}

# volume master uses PipeWire's PulseAudio compatibility layer (device = "pulse" works on Fedora 44)
volume master {
    device = "pulse"
    format = "VOL %volume"
    format_muted = "VOL muted"
    mixer = "Master"
}

time {
    format = "%a %d %b %H:%M"
}

{% for z in desktop_i3status_timezones %}
tztime team{{ loop.index }} {
    format = "{{ z.label | regex_replace('[^A-Za-z0-9]', '') }} %a %H:%M"
    timezone = "{{ z.timezone | regex_replace('[^A-Za-z0-9/_+-]', '') }}"
}

{% endfor %}
{% if _desktop_has_wired %}
ethernet _first_ {
    format_up = "ETH %ip"
    format_down = ""
}
{% endif %}

wireless _first_ {
    format_up = "WIFI %quality %ip"
    format_down = ""
}
