# {{ ansible_managed }}

general {
    colors = true
    interval = 5
}

order += "cpu_usage"
order += "cpu_temperature 0"
order += "memory"
order += "disk /"
order += "disk /home"
{% if desktop_i3status_show_battery %}order += "battery {{ desktop_i3status_battery_num }}"{% endif %}
order += "volume master"
order += "time"
order += "tztime utc"
order += "ethernet _first_"
order += "wireless _first_"

cpu_usage {
    format = " %usage"
    max_threshold = 80
}

# AMD k10temp via configurable hwmon path. i3status cpu_temperature requires a concrete path (no globs).
# Override desktop_i3status_cpu_temp_path in config.yml for different PCI topologies.
# Default: /sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon8/temp1_input (ThinkPad P16v Gen 1 AMD k10temp)
cpu_temperature 0 {
    format = " %degrees°C"
    path = "{{ desktop_i3status_cpu_temp_path }}"
    max_threshold = 90
}

memory {
    format = " %used / %total"
    threshold_degraded = "10%"
    format_degraded = " LOW (%available)"
}

disk "/" {
    format = " %avail"
    prefix_type = si
    low_threshold = 10
}

disk "/home" {
    format = " %avail"
    low_threshold = 20
    prefix_type = si
}

{% if desktop_i3status_show_battery %}
battery {{ desktop_i3status_battery_num }} {
    format = " %status %percentage %remaining"
    last_full_capacity = true
    status_chr = "⚡"
    status_bat = "🔋"
    status_full = "✓"
}
{% endif %}

# volume master uses PipeWire's PulseAudio compatibility layer (device = "pulse" works on Fedora 44)
volume master {
    device = "pulse"
    format = " %volume"
    format_muted = " muted"
    mixer = "Master"
}

time {
    format = " %a %d %b %H:%M"
}

tztime utc {
    format = " UTC %H:%M"
    timezone = "UTC"
}

ethernet _first_ {
    format_up = " %ip"
    format_down = ""
}

wireless _first_ {
    format_up = " (%quality) %ip"
    format_down = ""
}
