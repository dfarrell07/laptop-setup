# {{ ansible_managed }}

general {
    colors = true
    interval = 5
}

order += "cpu_usage"
order += "command cpu_temp"
order += "memory"
order += "disk /"
order += "disk /home"
order += "battery {{ desktop_i3status_battery_num }}"
order += "command"
order += "time"
order += "tztime utc"
order += "ethernet _first_"
order += "wireless _first_"

cpu_usage {
    format = " %usage"
    max_threshold = 80
}

# AMD k10temp via configurable PCI path (hwmon index varies across reboots; glob is safe in sh -c)
# Override desktop_i3status_cpu_temp_path in config.yml for different PCI topologies.
command "cpu_temp" {
    command = "awk '{printf \" %.0f°C\", $1/1000}' {{ desktop_i3status_cpu_temp_path }} 2>/dev/null || echo \" N/A\""
    interval = 5
}

memory {
    format = " %used / %total"
    threshold_degraded = "10%"
    format_degraded = " LOW (%available)"
}

disk "/" {
    format = " %avail"
    low_threshold = 10
}

disk "/home" {
    format = " %avail"
    low_threshold = 20
    prefix_type = si
}

battery {{ desktop_i3status_battery_num }} {
    format = " %status %percentage %remaining"
    last_full_capacity = true
    status_chr = "⚡"
    status_bat = "🔋"
    status_full = "✓"
}

# volume master block removed — ALSA 'default' shows N/A on PipeWire.
# Use pactl keybindings in i3.config for volume control.
command {
    command = "vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oP '\\d+%' | head -1); mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null); [ \"$mute\" = 'Mute: yes' ] && echo '🔇 muted' || echo \" $vol\""
    interval = 5
}

time {
    format = " %a %d %b %H:%M"
}

tztime utc {
    format = " UTC %H:%M"
    timezone = "UTC"
}

ethernet _first_ {
    format_up = " %ip"
    format_down = ""
}

wireless _first_ {
    format_up = " (%quality) %ip"
    format_down = ""
}
