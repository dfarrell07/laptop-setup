# {{ ansible_managed }}
# Ghostty on macOS, matched to the Linux Alacritty config (alacritty.toml.j2): same font, palette,
# no titlebar, xterm-256color for remote hosts, OSC 52 copy only.

font-family = {{ desktop_alacritty_font_family }}
font-size = {{ desktop_ghostty_font_size | float }}

# Hidden titlebar, not window-decoration = none: without a titled window AeroSpace floats or ignores Ghostty.
macos-titlebar-style = hidden
window-padding-x = 4
window-padding-y = 4

scrollback-limit = {{ desktop_ghostty_scrollback_bytes | int }}
term = xterm-256color

clipboard-read = deny
clipboard-write = allow

# Option is Alt in the shell (readline, tmux, vim), as on Linux; AeroSpace's alt bindings are global and still win.
macos-option-as-alt = true
confirm-close-surface = false
# Steady block cursor like Alacritty (no blink, no bar at the prompt from shell integration).
cursor-style-blink = false
shell-integration-features = no-cursor

background = {{ desktop_alacritty_color_bg }}
foreground = {{ desktop_alacritty_color_fg }}
cursor-color = {{ desktop_alacritty_color_fg }}
cursor-text = {{ desktop_alacritty_color_bg }}
palette = 0={{ desktop_alacritty_color_normal_black }}
palette = 1={{ desktop_alacritty_color_normal_red }}
palette = 2={{ desktop_alacritty_color_normal_green }}
palette = 3={{ desktop_alacritty_color_normal_yellow }}
palette = 4={{ desktop_alacritty_color_normal_blue }}
palette = 5={{ desktop_alacritty_color_normal_magenta }}
palette = 6={{ desktop_alacritty_color_normal_cyan }}
palette = 7={{ desktop_alacritty_color_normal_white }}
palette = 8={{ desktop_alacritty_color_bright_black }}
palette = 9={{ desktop_alacritty_color_normal_red }}
palette = 10={{ desktop_alacritty_color_normal_green }}
palette = 11={{ desktop_alacritty_color_normal_yellow }}
palette = 12={{ desktop_alacritty_color_normal_blue }}
palette = 13={{ desktop_alacritty_color_normal_magenta }}
palette = 14={{ desktop_alacritty_color_normal_cyan }}
palette = 15={{ desktop_alacritty_color_bright_white }}
