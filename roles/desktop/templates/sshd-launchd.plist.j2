<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{ ansible_managed }} -->
<!-- macOS's own sshd, as Remote Login runs it (com.openssh.sshd), on the Linux SSH port: launchd listens and starts
     sshd per connection; /etc/ssh/sshd_config and its drop-ins apply as usual. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ desktop_macos_sshd_label }}</string>
  <key>Program</key>
  <string>/usr/libexec/sshd-keygen-wrapper</string>
  <key>ProgramArguments</key>
  <array>
    <string>sshd-keygen-wrapper</string>
  </array>
  <key>inetdCompatibility</key>
  <dict>
    <key>Wait</key>
    <false/>
    <!-- one root sshd per connection, so cap them as Apple's ssh.plist does (per-connection sshd has no MaxStartups) -->
    <key>Instances</key>
    <integer>42</integer>
  </dict>
  <key>Sockets</key>
  <dict>
    <key>Listeners</key>
    <!-- No SockNodeName (Tailscale address): launchd binds at boot, maybe before tailscaled is up, leaving no sshd -->
    <dict>
      <key>SockServiceName</key>
      <string>{{ desktop_macos_ssh_port | int }}</string>
    </dict>
  </dict>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
  <!-- The process keys of Apple's ssh.plist, so sessions behave as under Remote Login: interactive scheduling, iCloud
       files evicted to the cloud download on open instead of failing, and no exit under memory pressure. -->
  <key>POSIXSpawnType</key>
  <string>Interactive</string>
  <key>MaterializeDatalessFiles</key>
  <true/>
  <key>EnablePressuredExit</key>
  <false/>
  <key>EnableTransactions</key>
  <false/>
</dict>
</plist>
