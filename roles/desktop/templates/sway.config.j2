# {{ ansible_managed }}

set $mod Mod4
set $term {{ desktop_terminal }}

font pango:{{ desktop_wm_font_family | regex_replace('[\n\r].*', '') }} {{ desktop_wm_font_size | int }}

# HiDPI output scaling (override desktop_sway_hidpi_scale in config.yml)
# adaptive_sync: VRR/FreeSync on AMD Radeon 780M; silently ignored on non-VRR displays or when docked
output {{ desktop_sway_output | regex_replace('[^a-zA-Z0-9*_-]', '') }} scale {{ desktop_sway_hidpi_scale | float }}{% if desktop_sway_adaptive_sync != '' %} adaptive_sync {{ desktop_sway_adaptive_sync }}{% endif %}
{% if desktop_sway_xwayland == 'disable' %}xwayland disable{% endif %}
{% if desktop_sway_workspace_outputs | length > 0 %}

# Workspace-to-output assignments (set desktop_sway_workspace_outputs list in config.yml)
{% for wo in desktop_sway_workspace_outputs %}
workspace {{ wo.workspace | regex_replace('[^a-zA-Z0-9_-]', '') }} output {{ wo.output | regex_replace('[^a-zA-Z0-9*_/-]', '') }}
{% endfor %}
{% endif %}

# Wayland-native rendering for Qt and Electron apps; AMD VA-API hardware decode;
# XCURSOR vars propagated so XWayland apps pick up cursor theme and size.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=sway QT_QPA_PLATFORM=wayland ELECTRON_OZONE_PLATFORM_HINT=wayland{% if desktop_sway_libva_driver %} LIBVA_DRIVER_NAME={{ desktop_sway_libva_driver | regex_replace('[^a-zA-Z0-9_-]', '') }}{% endif %}{% if desktop_sway_vdpau_driver %} VDPAU_DRIVER={{ desktop_sway_vdpau_driver | regex_replace('[^a-zA-Z0-9_-]', '') }}{% endif %} XCURSOR_THEME={{ desktop_sway_cursor_theme | regex_replace('[^a-zA-Z0-9_-]', '') }} XCURSOR_SIZE={{ desktop_sway_cursor_size | int }}
# Note: --systemd flag already propagates to systemd user session; no separate import-environment needed

# Notification daemon (exec_always so it restarts after 'swaymsg reload')
exec_always mako

# Clipboard history (clipboard contents survive source application close)
exec wl-paste --watch cliphist store

# Polkit agent (required for GUI privilege escalation — NetworkManager, USB mounts, etc.)
exec_always {{ desktop_sway_polkit_agent }}  # Qt6 Wayland-native polkit agent (lxqt-policykit pkg); polkit-gnome removed Fedora 41+
exec_always nm-applet

# Wallpaper
output * bg {{ desktop_bar_bg }} solid_color

# Idle and lock
exec swayidle -w \
    timeout {{ desktop_wm_idle_lock_timeout | int }} 'swaylock -f' \
    timeout {{ desktop_wm_idle_display_timeout | int }} 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f' \
    lock 'swaylock -f'

# Floating window drag/resize with mouse
floating_modifier $mod

# Terminal
bindsym $mod+Return exec $term

# Kill window
bindsym $mod+Shift+q kill

# Launcher
bindsym $mod+d exec wofi --show drun

# Clipboard history picker (cliphist stores history via wl-paste daemon)
bindsym $mod+Shift+v exec cliphist list | wofi --show dmenu | cliphist decode | wl-copy

# Display configuration (wdisplays — Wayland equivalent of arandr)
bindsym $mod+Shift+d exec wdisplays

{% include '_focus_move.j2' %}

# Split
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+Shift+b exec {{ desktop_wm_browser }}

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

{% include '_workspaces.j2' %}

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Manual screen lock ($mod+l is taken by focus-right; use $mod+Ctrl+l)
bindsym $mod+Ctrl+l exec swaylock -f

# Screenshot (grim + slurp)
bindsym Print exec grim - | tee ~/Pictures/screenshot-$(date +%F-%H-%M-%S).png | wl-copy -t image/png
bindsym $mod+Print exec sh -c 'f=~/Pictures/screenshot-$(date +%F-%H-%M-%S).png; grim -g "$(slurp)" "$f" && wl-copy -t image/png < "$f"'

# Audio (PipeWire via wpctl; -l 1.0 caps raise at 100%)
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Notifications
bindsym $mod+Shift+n exec makoctl dismiss
bindsym $mod+Ctrl+n exec makoctl dismiss --all

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Really exit Sway?' -B 'Yes' 'swaymsg exit'

# Appearance
default_border pixel {{ desktop_wm_border_width | int }}
default_floating_border pixel {{ desktop_wm_floating_border_width | int }}
{% if desktop_wm_hide_edge_borders | length > 0 %}hide_edge_borders {{ desktop_wm_hide_edge_borders | regex_replace('[^a-zA-Z_]', '') }}{% endif %}
{% if desktop_sway_gaps_inner != 0 %}gaps inner {{ desktop_sway_gaps_inner }}{% endif %}
{% if desktop_sway_gaps_outer != 0 %}gaps outer {{ desktop_sway_gaps_outer }}{% endif %}
{% if desktop_sway_focus_follows_mouse | length > 0 %}
focus_follows_mouse {{ desktop_sway_focus_follows_mouse | regex_replace('[^a-z]', '') }}
{% endif %}

# Input
input "type:keyboard" {
{% if desktop_sway_keyboard_layout %}
    xkb_layout {{ desktop_sway_keyboard_layout | regex_replace('[^a-z0-9,_-]', '') }}
{% endif %}
{% if desktop_sway_keyboard_variant %}
    xkb_variant {{ desktop_sway_keyboard_variant | regex_replace('[^a-z0-9,_-]', '') }}
{% endif %}
{% if desktop_sway_keyboard_options %}
    xkb_options {{ desktop_sway_keyboard_options | regex_replace('[^a-zA-Z0-9:,_-]', '') }}
{% endif %}
    repeat_delay {{ desktop_wm_repeat_delay | int }}
    repeat_rate {{ desktop_wm_repeat_rate | int }}
}

seat seat0 xcursor_theme {{ desktop_sway_cursor_theme | regex_replace('[^a-zA-Z0-9_-]', '') }} {{ desktop_sway_cursor_size | int }}

{% if desktop_sway_touchpad_tap != '' or desktop_sway_touchpad_natural_scroll != '' or desktop_sway_touchpad_dwt != '' or desktop_sway_touchpad_middle_emulation != '' %}
input "type:touchpad" {
    {% if desktop_sway_touchpad_tap != '' %}tap {{ desktop_sway_touchpad_tap }}{% endif %}
    {% if desktop_sway_touchpad_natural_scroll != '' %}natural_scroll {{ desktop_sway_touchpad_natural_scroll }}{% endif %}
    {% if desktop_sway_touchpad_dwt != '' %}dwt {{ desktop_sway_touchpad_dwt }}{% endif %}
    {% if desktop_sway_touchpad_middle_emulation != '' %}middle_emulation {{ desktop_sway_touchpad_middle_emulation }}{% endif %}
}
{% endif %}

# TrackPoint scroll: on_button_down (hold middle button) must be scoped to the
# TrackPoint device only — applying it via 'type:pointer' breaks Bluetooth mice.
# Find the exact identifier with: swaymsg -t get_inputs | grep -A2 TrackPoint
# Then set desktop_sway_trackpoint_id in config.yml, e.g.:
#   desktop_sway_trackpoint_id: "2:10:TPPS/2_IBM_TrackPoint"
{% if desktop_sway_trackpoint_id %}
input "{{ desktop_sway_trackpoint_id | regex_replace('[^a-zA-Z0-9 ./:_-]', '') }}" {
    scroll_method on_button_down
    scroll_button 274
    scroll_factor {{ desktop_sway_trackpoint_scroll_factor | float }}
    accel_profile {{ desktop_sway_trackpoint_accel_profile | regex_replace('[^a-z]', '') }}
    pointer_accel {{ desktop_sway_trackpoint_pointer_accel | float }}
}
{% endif %}

# Status bar
{% include '_bar_colors.j2' %}
