# {{ ansible_managed }}

set $mod Mod4
set $term {{ desktop_terminal }}

font pango:{{ desktop_wm_font_family }} {{ desktop_wm_font_size }}

# HiDPI output scaling (override desktop_sway_hidpi_scale in config.yml)
# adaptive_sync: VRR/FreeSync on AMD Radeon 780M; silently ignored on non-VRR displays or when docked
output {{ desktop_sway_output }} scale {{ desktop_sway_hidpi_scale }} adaptive_sync {{ desktop_sway_adaptive_sync }}
xwayland {{ desktop_sway_xwayland }}
{% if desktop_sway_workspace_outputs | default([]) | length > 0 %}

# Workspace-to-output assignments (set desktop_sway_workspace_outputs list in config.yml)
{% for wo in desktop_sway_workspace_outputs %}
workspace {{ wo.workspace }} output {{ wo.output }}
{% endfor %}
{% endif %}

# Wayland-native rendering for Qt and Electron apps; AMD VA-API hardware decode;
# XCURSOR vars propagated so XWayland apps pick up cursor theme and size.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway QT_QPA_PLATFORM=wayland ELECTRON_OZONE_PLATFORM_HINT=wayland LIBVA_DRIVER_NAME={{ desktop_sway_libva_driver }} VDPAU_DRIVER={{ desktop_sway_vdpau_driver }} XCURSOR_THEME={{ desktop_sway_cursor_theme }} XCURSOR_SIZE={{ desktop_sway_cursor_size }}
# Note: --systemd flag already propagates to systemd user session; no separate import-environment needed

# Notification daemon (exec_always so it restarts after 'swaymsg reload')
exec_always mako

# Clipboard history (clipboard contents survive source application close)
exec wl-paste --watch cliphist store

# Polkit agent (required for GUI privilege escalation — NetworkManager, USB mounts, etc.)
exec_always {{ desktop_sway_polkit_agent }}  # Qt6 Wayland-native polkit agent (lxqt-policykit pkg); polkit-gnome removed Fedora 41+
exec_always nm-applet

# Wallpaper
output * bg {{ desktop_bar_bg }} solid_color

# Idle and lock
exec swayidle -w \
    timeout {{ desktop_sway_idle_lock_timeout }} 'swaylock -f -c {{ desktop_sway_lock_color }}' \
    timeout {{ desktop_sway_idle_display_timeout }} 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c {{ desktop_sway_lock_color }}'

# Floating window drag/resize with mouse
floating_modifier $mod

# Terminal
bindsym $mod+Return exec $term

# Kill window
bindsym $mod+Shift+q kill

# Launcher
bindsym $mod+d exec wofi --show drun

# Clipboard history picker (cliphist stores history via wl-paste daemon)
bindsym $mod+Shift+v exec cliphist list | wofi --show dmenu | cliphist decode | wl-copy

# Display configuration (wdisplays — Wayland equivalent of arandr)
bindsym $mod+Shift+d exec wdisplays

# Focus (vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+Shift+b exec {{ desktop_sway_browser }}

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Manual screen lock ($mod+l is taken by focus-right; use $mod+Ctrl+l)
bindsym $mod+Ctrl+l exec swaylock -f -c {{ desktop_sway_lock_color }}

# Screenshot (grim + slurp)
bindsym Print exec grim - | tee ~/Pictures/screenshot-$(date +%F-%T).png | wl-copy -t image/png
bindsym $mod+Print exec grim -g "$(slurp)" - | tee ~/Pictures/screenshot-$(date +%F-%T).png | wl-copy -t image/png

# Audio (PipeWire via wpctl; -l 1.0 caps raise at 100%)
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
# Notifications
bindsym $mod+Shift+n exec makoctl dismiss
bindsym $mod+Ctrl+n exec makoctl dismiss --all

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit

# Appearance
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
gaps inner 8
gaps outer 4
focus_follows_mouse no

# Input
input "type:keyboard" {
    xkb_layout {{ desktop_sway_keyboard_layout }}
    repeat_delay {{ desktop_sway_repeat_delay }}
    repeat_rate {{ desktop_sway_repeat_rate }}
}

seat seat0 xcursor_theme {{ desktop_sway_cursor_theme }} {{ desktop_sway_cursor_size }}

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
}

# TrackPoint scroll: on_button_down (hold middle button) must be scoped to the
# TrackPoint device only — applying it via 'type:pointer' breaks Bluetooth mice.
# Find the exact identifier with: swaymsg -t get_inputs | grep -A2 TrackPoint
# Then set desktop_sway_trackpoint_id in config.yml, e.g.:
#   desktop_sway_trackpoint_id: "2:10:TPPS/2_IBM_TrackPoint"
{% if desktop_sway_trackpoint_id is defined and desktop_sway_trackpoint_id %}
input "{{ desktop_sway_trackpoint_id }}" {
    scroll_method on_button_down
    scroll_button 274
    scroll_factor 0.5
    accel_profile {{ desktop_sway_trackpoint_accel_profile }}
    pointer_accel {{ desktop_sway_trackpoint_pointer_accel }}
}
{% endif %}

# Status bar
bar {
    status_command i3status --config {{ ansible_facts['user_dir'] }}/.config/i3status/config
    position top
    colors {
        background {{ desktop_bar_bg }}
        statusline {{ desktop_bar_fg }}
        separator {{ desktop_bar_separator }}
        # Workspace button colors (border / background / text)
        focused_workspace  {{ desktop_bar_focused_ws_bg }} {{ desktop_bar_focused_ws_bg }} {{ desktop_bar_focused_ws_text }}
        active_workspace   {{ desktop_bar_active_ws_bg }} {{ desktop_bar_active_ws_bg }} {{ desktop_bar_active_ws_text }}
        inactive_workspace {{ desktop_bar_inactive_ws_bg }} {{ desktop_bar_inactive_ws_bg }} {{ desktop_bar_inactive_ws_text }}
        urgent_workspace   {{ desktop_bar_urgent_ws_bg }} {{ desktop_bar_urgent_ws_bg }} {{ desktop_bar_urgent_ws_text }}
        binding_mode       {{ desktop_bar_binding_mode_bg }} {{ desktop_bar_binding_mode_bg }} {{ desktop_bar_binding_mode_text }}
    }
}
