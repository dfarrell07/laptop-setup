# {{ ansible_managed }}

[font]
size = {{ desktop_alacritty_font_size }}

[font.normal]
family = "{{ desktop_alacritty_font_family }}"

[window]
padding = { x = 4, y = 4 }
decorations = "None"

[scrolling]
history = 50000

[env]
# Override TERM so remote SSH hosts without alacritty terminfo still work correctly.
# tmux and vim inside alacritty still get 256-color support via terminal-overrides in tmux.conf.
TERM = "xterm-256color"

[terminal]
osc52 = "OnlyCopy"

[colors.primary]
background = "{{ desktop_alacritty_color_bg }}"
foreground = "{{ desktop_alacritty_color_fg }}"

[colors.cursor]
text = "{{ desktop_alacritty_color_bg }}"
cursor = "{{ desktop_alacritty_color_fg }}"

[colors.normal]
black = "{{ desktop_alacritty_color_normal_black }}"
red = "{{ desktop_alacritty_color_normal_red }}"
green = "{{ desktop_alacritty_color_normal_green }}"
yellow = "{{ desktop_alacritty_color_normal_yellow }}"
blue = "{{ desktop_alacritty_color_normal_blue }}"
magenta = "{{ desktop_alacritty_color_normal_magenta }}"
cyan = "{{ desktop_alacritty_color_normal_cyan }}"
white = "{{ desktop_alacritty_color_normal_white }}"

[colors.bright]
black = "{{ desktop_alacritty_color_bright_black }}"
red = "{{ desktop_alacritty_color_bright_red }}"
green = "{{ desktop_alacritty_color_bright_green }}"
yellow = "{{ desktop_alacritty_color_bright_yellow }}"
blue = "{{ desktop_alacritty_color_bright_blue }}"
magenta = "{{ desktop_alacritty_color_bright_magenta }}"
cyan = "{{ desktop_alacritty_color_bright_cyan }}"
white = "{{ desktop_alacritty_color_bright_white }}"
