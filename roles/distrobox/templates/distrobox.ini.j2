# {{ ansible_managed }}
[{{ distrobox_container_name | regex_replace('[\r\n]', '') }}]
image={{ distrobox_container_image | regex_replace('[\r\n]', '') }}
# distrobox runs podman create with --privileged, label=disable and apparmor=unconfined. The container is
# rootless, so capabilities apply only inside its user namespace.
# WARNING: lowering system_unprivileged_bpf_disabled in config.yml exposes bpf() to every process in the
# container (including transitive npm/cargo/pip dependencies). See references/troubleshooting.md
# "kernel.unprivileged_bpf_disabled=2 (default)".
# --cgroupns=private: container sees only its own cgroup subtree, not host service/PID metadata.
# ACCEPTED RISK: systemd-in-container may behave unexpectedly under a private cgroup namespace
# if the container runtime assigns a deep slice path that systemd cannot fully introspect.
# Tested with Podman rootless + crun; if systemd fails to start, remove --cgroupns=private
# and document the specific runtime version as a known exception.
{% if distrobox_use_host_network %}
# Host networking: container shares the host network namespace.
# Required for OVN-K/bpfman scenarios; set distrobox_use_host_network: false for general dev.
# Distrobox supplies --network=host itself; a second network flag conflicts.
additional_flags=--cgroupns=private
{% else %}
# Isolated network (pasta): container has its own network namespace.
# Set distrobox_use_host_network: true in config.yml only for OVN-K/bpfman host-network scenarios.
# Disable Distrobox's implicit host network before choosing pasta.
unshare_netns=true
additional_flags=--network=pasta --cgroupns=private
{% endif %}

additional_packages={{ distrobox_packages | map('regex_replace', '[\r\n]', '') | join(' ') }}

# Host delegation symlinks at every container start, so they exist before Play 3 provisions the container.
# ACCEPTED RISK: each entry creates /usr/local/bin/<cmd> -> /usr/bin/distrobox-host-exec (delegates to the
# host); the allowlist in roles/distrobox/tasks/main.yml rejects shells and arbitrary binaries.
{% for cmd in distrobox_host_exec_commands %}
init_hooks=mkdir -p /usr/local/bin && ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/{{ cmd | quote }} || true;
{% endfor %}
