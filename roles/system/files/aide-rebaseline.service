# Ansible managed
[Unit]
Description=Accept package changes into the AIDE baseline after dnf-automatic
Documentation=man:aide(1)
# dnf-automatic leaves this marker when a run wrote the RPM database. Enabled at boot too, so a run that shutdown
# interrupted (normal stop timeout: shutdown never waits minutes for AIDE) retries.
ConditionPathExists=/var/lib/aide/rebaseline-pending
After=local-fs.target

[Service]
Type=oneshot
# Exit 8 or more is an AIDE error (as in `make aide-rebaseline`): discard its output, keep the marker, fail the unit
# (the status bar shows UPD). '$$' is a literal '$' for bash.
ExecStart=/usr/bin/bash -c 'aide --update; rc=$$?; if [ $$rc -lt 8 ] && [ -f /var/lib/aide/aide.db.new.gz ]; then mv /var/lib/aide/aide.db.new.gz /var/lib/aide/aide.db.gz && rm -f /var/lib/aide/rebaseline-pending; else rm -f /var/lib/aide/aide.db.new.gz; exit 1; fi'
Nice=15
IOSchedulingClass=idle
SyslogIdentifier=aide-rebaseline

[Install]
WantedBy=multi-user.target
