# {{ ansible_managed }}
# NTS-authenticated time sources
{% for server in system_chrony_nts_servers %}
server {{ server }} iburst nts
{% endfor %}

# Unauthenticated fallback (used when fewer than minsources={{ system_chrony_minsources }} NTS servers respond)
pool {{ system_chrony_fallback_pool }} iburst

# Prefer NTS; fall back to pool only when NTS unavailable
authselectmode prefer

# Use NTP servers from DHCP
sourcedir /run/chrony-dhcp

# Persist NTS cookies across restarts
ntsdumpdir /var/lib/chrony

driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
leapseclist /usr/share/zoneinfo/leap-seconds.list
leapsecmode slew
minsources {{ system_chrony_minsources }}
logdir /var/log/chrony
