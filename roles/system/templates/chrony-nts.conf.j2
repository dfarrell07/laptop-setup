# {{ ansible_managed }}
# NTS-authenticated time sources
{% for server in system_chrony_nts_servers %}
server {{ server }} iburst nts
{% endfor %}

# Unauthenticated fallback — used by authselectmode prefer when NTS sources are unreachable (port 4460 blocked, NTS-KE fails). minsources={{ system_chrony_minsources }} is the minimum sources before clock adjustment, a separate concern.
pool {{ system_chrony_fallback_pool }} iburst

# Prefer NTS; fall back to pool only when NTS unavailable
authselectmode {{ system_chrony_authselectmode }}

# Use NTP servers from DHCP
sourcedir {{ system_chrony_dhcp_sourcedir }}

# Persist NTS cookies across restarts
ntsdumpdir {{ system_chrony_ntsdumpdir }}

driftfile {{ system_chrony_driftfile }}
makestep {{ system_chrony_makestep }}
rtcsync
leapseclist {{ system_chrony_leapseclist }}
leapsecmode {{ system_chrony_leapsecmode }}
minsources {{ system_chrony_minsources }}
logdir {{ system_chrony_logdir }}
