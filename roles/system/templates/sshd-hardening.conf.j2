# {{ ansible_managed }}
# Drop-in hardening for sshd — deployed to /etc/ssh/sshd_config.d/

Port {{ ssh_port }}
Banner /etc/issue.net
# WARNING: password auth is disabled. Before running make all, ensure
# ~/.ssh/authorized_keys holds at least one ssh-ed25519 or
# sk-ssh-ed25519@openssh.com key — RSA/ECDSA are silently rejected by
# PubkeyAcceptedAlgorithms below. A missing or wrong-type key causes a
# complete SSH lockout once sshd restarts. If no hardware key is available:
#   ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_local -C "local-bootstrap"
#   cat ~/.ssh/id_ed25519_local.pub > ~/.ssh/authorized_keys
# Alternatively, populate vault.yml with vault_ssh_auth_key_pub (ed25519).
PasswordAuthentication no
KbdInteractiveAuthentication no  # compiled default yes; 50-redhat.conf currently also sets no; explicit here so hardening holds if drop-ins are reordered or 50-redhat.conf changes
PermitRootLogin no
PermitEmptyPasswords no  # OpenSSH compiled default; unreachable because both PasswordAuthentication no (line 14) and KbdInteractiveAuthentication no (line 15) close all password-equivalent auth paths (UsePAM yes makes both relevant)
HostKeyAlgorithms {{ ssh_host_key_algorithms }}  # cert variant excluded intentionally (no host CA); add ssh-ed25519-cert-v01@openssh.com here and configure TrustedUserCAKeys if deploying host certs
PubkeyAcceptedAlgorithms {{ ssh_pubkey_accepted_algorithms | join(',') }}  # ed25519 and FIDO2, plain and cert variants; cert auth requires cert-authority in authorized_keys or TrustedUserCAKeys; RSA/ECDSA rejected
AuthorizedKeysFile .ssh/authorized_keys  # Fedora's sshd_config already restricts this; explicit here for auditability and resilience against base-config reset

AllowUsers {{ real_user_id }}
MaxAuthTries 3
MaxSessions {{ system_ssh_max_sessions }}  # OpenSSH default is 10; explicit so value is auditable and config.yml overrides are visible in the drop-in
LoginGraceTime 30

X11Forwarding no  # compiled default no; overrides 50-redhat.conf which sets yes on Fedora/RHEL
AllowAgentForwarding {{ system_ssh_allow_agent_forwarding }}
AllowTcpForwarding {{ system_ssh_allow_tcp_forwarding }}
# NOTE: AcceptEnv is cumulative in sshd — 50-redhat.conf AcceptEnv COLORTERM cannot be
# overridden from this file regardless of drop-in order. COLORTERM forwarding is always active.

ClientAliveInterval {{ system_ssh_client_alive_interval }}
ClientAliveCountMax {{ system_ssh_client_alive_count_max }}  # compiled default 3; tightened to 2 — disconnect after 2 unacknowledged keepalive probes (10 min with ClientAliveInterval 300)
# ChannelTimeout and UnusedConnectionTimeout require OpenSSH >= 9.2 (2023-02-02).
# Fedora 44 ships 10.2p1; Rocky Linux 10 ships 9.9p1 — both well above minimum.
# NOTE: this only matters if you enable ChannelTimeout — the OpenSSH 10.3 (bz3827) bug fixed
# UnusedConnectionTimeout firing prematurely; API-style clients on OpenSSH < 10.3 may disconnect early.
# Default: disabled (system_ssh_channel_timeout: ""); set e.g. "global 1h" in config.yml once all targets run OpenSSH >= 10.3.
{% if system_ssh_channel_timeout %}
ChannelTimeout {{ system_ssh_channel_timeout }}
{% endif %}
# system_ssh_unused_connection_timeout: default 600 — directive is always emitted; set '' in config.yml to omit directive; integer 0 is also falsy and omits it (not emitted as UnusedConnectionTimeout 0).
{% if system_ssh_unused_connection_timeout %} {# '' or 0 to omit/disable #}
UnusedConnectionTimeout {{ system_ssh_unused_connection_timeout }}
{% endif %}
TCPKeepAlive no  # OpenSSH compiled default is yes; disabled in favour of encrypted ClientAlive messages (ClientAliveInterval/CountMax above)
SyslogFacility AUTHPRIV  # forward guard: 50-redhat.conf also sets AUTHPRIV; compiled default is AUTH; 00-hardening.conf wins via first-occurrence lexicographic order
LogLevel VERBOSE
UsePAM yes  # compiled default no; setting no bypasses PAM account/session modules (faillock lockout, audit, MOTD); matches 50-redhat.conf; explicit (first-occurrence)
MaxStartups 10:30:60  # start:rate:full; full ceiling tightened from OpenSSH default 10:30:100
RekeyLimit 1G 1h  # OpenSSH default: cipher-dependent data only, no time limit; 1h bounds session-key exposure window
Compression no  # OpenSSH 10.2p1 (Fedora 44) compiled default is yes; disabled — no benefit for interactive sessions and reduces protocol complexity
GSSAPIAuthentication no  # overrides 50-redhat.conf which sets yes on Fedora/RHEL; without this line the effective value is yes even though the compiled default is no

# CIS 4.2.12 — approved algorithms. NOTE: sshd processes drop-in files lexicographically;
# 00-hardening.conf loads before 40-redhat-crypto-policies.conf, so this explicit list
# takes precedence over the system crypto policy for SSH. This is intentional — the system
# crypto policy is more permissive than this hardened list. update-crypto-policies
# configures sshd via 40-redhat-crypto-policies.conf, but this file takes precedence:
# sshd uses first-occurrence semantics and 00-hardening.conf sorts alphabetically before
# 40-redhat-crypto-policies.conf.
Ciphers {{ ssh_ciphers }}
MACs {{ ssh_macs }}  # MACs controls the MAC algorithm negotiation for all connections; for AEAD ciphers (gcm, chacha20) the negotiated MAC algorithm is not applied for packet authentication — the cipher provides authentication intrinsically
KexAlgorithms {{ ssh_kex_algorithms }}
