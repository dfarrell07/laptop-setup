# {{ ansible_managed }}
# Drop-in hardening for sshd — deployed to /etc/ssh/sshd_config.d/

Port {{ ssh_port }}
Banner /etc/issue.net
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
HostKeyAlgorithms ssh-ed25519
AuthorizedKeysFile .ssh/authorized_keys
PubkeyAuthentication yes
HostbasedAuthentication no
IgnoreRhosts yes
PermitUserEnvironment no

AllowUsers {{ real_user_id }}
MaxAuthTries 3
MaxSessions 2
LoginGraceTime 30

X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no

ClientAliveInterval 300
ClientAliveCountMax 2
# ChannelTimeout and UnusedConnectionTimeout require OpenSSH >= 9.2 (2023-02-02).
# Fedora 44 ships 10.2p1; Rocky Linux 10 ships 9.9p1 — both well above minimum.
# OpenSSH 10.3 (bz3827) fixed UnusedConnectionTimeout firing prematurely after a
# ChannelTimeout; standard ssh(1) clients are unaffected (they exit when all channels
# close), but API-style clients on OpenSSH < 10.3 may disconnect prematurely.
ChannelTimeout session=10m
UnusedConnectionTimeout 600
TCPKeepAlive no
LogLevel VERBOSE
UsePAM yes
StrictModes yes
UseDNS no
MaxStartups 10:30:60
RekeyLimit 1G 1h
Compression no
GSSAPIAuthentication no
PrintLastLog yes

# CIS 4.2.12 — approved algorithms. NOTE: sshd processes drop-in files lexicographically;
# 00-hardening.conf loads before 40-redhat-crypto-policies.conf, so this explicit list
# takes precedence over the system crypto policy for SSH. This is intentional — the system
# crypto policy is more permissive than this hardened list. update-crypto-policies
# applies to other subsystems (OpenSSL, GnuTLS) but does NOT affect sshd algorithm selection.
Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256,ecdh-sha2-nistp521,ecdh-sha2-nistp384,ecdh-sha2-nistp256,diffie-hellman-group-exchange-sha256
