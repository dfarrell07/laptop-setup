# {{ ansible_managed }}
# Drop-in hardening for sshd — deployed to /etc/ssh/sshd_config.d/

Port {{ ssh_port }}
Banner /etc/issue.net
# WARNING: password auth is disabled. Before running make all, ensure
# ~/.ssh/authorized_keys holds at least one ssh-ed25519 or
# sk-ssh-ed25519@openssh.com key — RSA/ECDSA are silently rejected by
# PubkeyAcceptedAlgorithms below. A missing or wrong-type key causes a
# complete SSH lockout once sshd restarts. If no hardware key is available:
#   ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_local -C "local-bootstrap"
#   cat ~/.ssh/id_ed25519_local.pub > ~/.ssh/authorized_keys
# Alternatively, populate vault.yml with vault_ssh_auth_key_pub (ed25519).
PasswordAuthentication no
KbdInteractiveAuthentication no  # matches 50-redhat.conf; explicit to guard against upstream changes
PermitRootLogin no
PermitEmptyPasswords no
HostKeyAlgorithms {{ ssh_host_key_algorithms }}
PubkeyAcceptedAlgorithms {{ ssh_pubkey_accepted_algorithms | join(',') }}
AuthorizedKeysFile .ssh/authorized_keys
PubkeyAuthentication yes
HostbasedAuthentication no
PermitUserEnvironment no

AllowUsers {{ real_user_id }}
MaxAuthTries 3
MaxSessions {{ system_ssh_max_sessions }}  # OpenSSH default is 10; override system_ssh_max_sessions in config.yml
LoginGraceTime 30

X11Forwarding no  # overrides 50-redhat.conf (sets yes)
AllowAgentForwarding {{ system_ssh_allow_agent_forwarding }}
AllowTcpForwarding {{ system_ssh_allow_tcp_forwarding }}

ClientAliveInterval 300
ClientAliveCountMax 2
# ChannelTimeout and UnusedConnectionTimeout require OpenSSH >= 9.2 (2023-02-02).
# Fedora 44 ships 10.2p1; Rocky Linux 10 ships 9.9p1 — both well above minimum.
# OpenSSH 10.3 (bz3827) fixed UnusedConnectionTimeout firing prematurely after a
# ChannelTimeout; standard ssh(1) clients are unaffected (they exit when all channels
# close), but API-style clients on OpenSSH < 10.3 may disconnect prematurely.
# To re-enable: set system_ssh_channel_timeout (e.g. "global 1h") in config.yml once all targets run OpenSSH >= 10.3.
{% if system_ssh_channel_timeout | string != '' %}
ChannelTimeout {{ system_ssh_channel_timeout }}
{% endif %}
# system_ssh_unused_connection_timeout: default 600; set '' in config.yml to omit this directive
{% if system_ssh_unused_connection_timeout | string != '' %}
UnusedConnectionTimeout {{ system_ssh_unused_connection_timeout }}
{% endif %}
TCPKeepAlive no
LogLevel VERBOSE
UsePAM yes  # compiled default no; matches 50-redhat.conf; explicit (first-occurrence)
MaxStartups 10:30:60
RekeyLimit 1G 1h
GSSAPIAuthentication no  # overrides 50-redhat.conf (sets yes)

# CIS 4.2.12 — approved algorithms. NOTE: sshd processes drop-in files lexicographically;
# 00-hardening.conf loads before 40-redhat-crypto-policies.conf, so this explicit list
# takes precedence over the system crypto policy for SSH. This is intentional — the system
# crypto policy is more permissive than this hardened list. update-crypto-policies
# configures sshd via 40-redhat-crypto-policies.conf, but this file takes precedence:
# sshd uses first-occurrence semantics and 00-hardening.conf sorts alphabetically before
# 40-redhat-crypto-policies.conf.
Ciphers {{ ssh_ciphers }}
MACs {{ ssh_macs }}
KexAlgorithms {{ ssh_kex_algorithms }}
