# {{ ansible_managed }}
# Security hardening sysctl values
{% for key, value in system_sysctl_hardening.items() %}
{% if key != 'kernel.modules_disabled' %}
{% if key == 'kernel.unprivileged_bpf_disabled' %}
# NOTE: EPERM-locked on stock Fedora 44 — kernel enforces 2 at boot via
# CONFIG_BPF_UNPRIV_DEFAULT_OFF=y before sysctl.d is processed; this entry
# is a no-op on stock Fedora 44 but retained for portability to custom kernels.
{% endif %}
{% if key in ['net.ipv4.conf.all.secure_redirects', 'net.ipv4.conf.default.secure_redirects'] %}
# NOTE: secure_redirects is a no-op while accept_redirects=0 (hardening-critical, not overridable)
{% endif %}
{% if key in ['fs.protected_regular', 'fs.protected_fifos'] %}
# Intentionally 2, not vendor default 1; covers group-writable sticky dirs.
# (sysctl.d has no trailing comments: text after the value would be written to /proc.)
{% endif %}
{{ key | regex_replace('[^a-zA-Z0-9._-]', '') }} = {{ (value | string | regex_replace('[`$();&<>]', '') if key == 'kernel.core_pattern' else value | string) | regex_replace('[\r\n].*', '') }}
{% if key in ['net.ipv6.conf.all.use_tempaddr', 'net.ipv6.conf.default.use_tempaddr'] and system_ipv6_accept_ra | int == 0 %}
# NOTE: use_tempaddr is inert — SLAAC disabled (accept_ra=0); set system_ipv6_accept_ra: 2 to activate
{% endif %}
{% endif %}
{% endfor %}
