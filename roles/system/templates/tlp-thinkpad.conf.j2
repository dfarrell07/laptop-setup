# {{ ansible_managed }}
# TLP ThinkPad battery charge threshold configuration.
# Deployed as a drop-in to /etc/tlp.d/ (overrides /etc/tlp.conf defaults).
# Target: ThinkPad P16v Gen 1 AMD — uses thinkpad_acpi sysfs interface.
# No reboot required; changes apply immediately on 'systemctl restart tlp'.
#
# Li-ion longevity: keeping charge between 20-80% significantly extends
# battery cycle life. Override system_tlp_bat0_start/stop in config.yml.

TLP_ENABLE=1

# Battery charge thresholds (uses thinkpad_acpi — no extra kernel modules needed)
# BAT0 = main battery. BAT1 entries use the same thresholds as BAT0 (harmless on
# single-battery models like the P16v; silently ignored for absent battery slots).
START_CHARGE_THRESH_BAT0={{ system_tlp_bat0_start }}
STOP_CHARGE_THRESH_BAT0={{ system_tlp_bat0_stop }}
START_CHARGE_THRESH_BAT1={{ system_tlp_bat0_start }}
STOP_CHARGE_THRESH_BAT1={{ system_tlp_bat0_stop }}

# WiFi power: leave at TLP default (auto).
# NM's 99-wifi-powersave.conf pins wifi.powersave=2 (disabled) — NM config wins.

# PCIe/NVMe power management on battery (ASPM + runtime PM)
# PCIE_ASPM_ON_BAT=powersupersave enables L1 substates (L1.1/L1.2) for PCIe links.
# RUNTIME_PM_ON_BAT=auto enables kernel runtime suspend for PCIe devices (NVMe, etc.)
# but NOT USB — USB autosuspend is a separate TLP mechanism (USB_AUTOSUSPEND, on by
# default). The Radeon 780M is excluded from RUNTIME_PM by TLP's RUNTIME_PM_DRIVER_DENYLIST
# (contains amdgpu); GPU manages its own runtime PM independently via amdgpu.runpm.
# Note: RUNTIME_PM_ON_AC and RUNTIME_PM_ON_BAT match TLP defaults — listed here
# explicitly to document the intended state alongside the PCIE_ASPM override.
PCIE_ASPM_ON_AC=default
PCIE_ASPM_ON_BAT=powersupersave
RUNTIME_PM_ON_AC=on
RUNTIME_PM_ON_BAT=auto

# CPU power (AMD Ryzen 7840U — amd-pstate-epp active mode)
# With amd-pstate-epp, the scaling_governor is locked to 'powersave'.
# CPU_SCALING_GOVERNOR_ON_BAT is ignored; EPP is the only effective CPU power knob.
# balance_power on battery reduces CPU power draw at the cost of burst performance.
CPU_ENERGY_PERF_POLICY_ON_AC=balance_performance
CPU_ENERGY_PERF_POLICY_ON_BAT=balance_power
