# {{ ansible_managed }}
# dnf-automatic / dnf5-automatic configuration
# Overrides vendor defaults at /usr/share/dnf5/dnf5-plugins/automatic.conf

[commands]
# Apply updates (not just download); upgrade_type below limits them to security advisories
apply_updates = {{ 'yes' if system_dnf_automatic_apply_updates else 'no' }}
download_updates = yes

# Security advisories only — applies kernel, container runtime, and compiler security updates.
# Note: kernel security updates ARE included; if mid-session kernel updates are disruptive,
# disable auto-apply (apply_updates = no) to download only.
upgrade_type = security

# Wait up to 60s for network
network_online_timeout = 60

# Random delay before download (timer already adds up to 60m jitter)
random_sleep = 0

# Never auto-reboot
reboot = never

[emitters]
emit_via = stdio
emit_no_updates = no

# NOTE: dnf5 has no config-level repo exclusion. To keep a third-party repo
# out of auto-updates, set enabled=0 in its .repo file.

{% if proxy_url %}
[main]
proxy = {{ proxy_url | regex_replace('[\r\n].*', '') }}
{% endif %}
