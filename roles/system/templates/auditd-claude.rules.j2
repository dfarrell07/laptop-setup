# {{ ansible_managed }}
# Audit rules for sensitive file access monitoring

# Exclusion rules (MUST come before syscall rules — first-match wins).
# These suppress noise from well-known agents when syscall rules are added.
# They have no effect on the watch (-w) rules below.
-a never,exit -F exe=/usr/bin/ssh-agent -k exclude-ssh-agent
-a never,exit -F exe=/usr/bin/gpg-agent -k exclude-gpg-agent

# Write/attribute changes on frequently-accessed sensitive paths
-w {{ real_user_home }}/.ssh/ -p wa -k claude-sensitive-write
-w {{ real_user_home }}/.gnupg/ -p wa -k claude-sensitive-write
-w {{ real_user_home }}/.kube/config -p wa -k claude-sensitive-write

# Read access on rarely-accessed high-value files
-w {{ real_user_home }}/.aws/ -p r -k claude-sensitive-read
-w {{ real_user_home }}/.vault_pass.sh -p r -k claude-sensitive-read
-w {{ real_user_home }}/.claude/.credentials.json -p r -k claude-sensitive-read
-w {{ real_user_home }}/.config/containers/auth.json -p r -k claude-sensitive-read
-w {{ real_user_home }}/.config/gcloud/ -p r -k claude-sensitive-read
-w {{ real_user_home }}/.config/gh/ -p r -k claude-sensitive-read
-w {{ real_user_home }}/.config/acli/ -p r -k claude-sensitive-read
-w {{ real_user_home }}/.docker/config.json -p r -k claude-sensitive-read
-w {{ real_user_home }}/.netrc -p r -k claude-sensitive-read
-w /etc/sudoers -p wa -k privilege-escalation
-w /etc/sudoers.d/ -p wa -k privilege-escalation
-w /etc/ssh/sshd_config -p wa -k privilege-escalation
-w /etc/ssh/sshd_config.d/ -p wa -k privilege-escalation

# System identity and authentication files
-w /etc/passwd -p wa -k identity-change
-w /etc/shadow -p wa -k identity-change
-w /etc/group -p wa -k identity-change
-w /etc/gshadow -p wa -k identity-change
-w /etc/security/opasswd -p wa -k identity-change
-w /etc/pam.d/ -p wa -k auth-config
-w /etc/selinux/ -p wa -k mac-policy
-w /etc/NetworkManager/ -p wa -k network-config

# Persistence mechanisms (system)
-w /etc/cron.d/ -p wa -k persistence
-w /etc/cron.daily/ -p wa -k persistence
-w /etc/cron.hourly/ -p wa -k persistence
-w /etc/cron.weekly/ -p wa -k persistence
-w /etc/cron.monthly/ -p wa -k persistence
-w /etc/crontab -p wa -k persistence
-w /etc/systemd/system/ -p wa -k persistence
-w /etc/profile.d/ -p wa -k persistence
-w /etc/ld.so.conf.d/ -p wa -k persistence
-w /var/spool/cron/ -p wa -k persistence

# User-level persistence
-w {{ real_user_home }}/.config/systemd/user/ -p wa -k user-persistence
-w {{ real_user_home }}/.config/autostart/ -p wa -k user-persistence
-w {{ real_user_home }}/.config/environment.d/ -p wa -k user-persistence
-w {{ real_user_home }}/.zshrc -p wa -k shell-persistence
-w {{ real_user_home }}/.zshenv -p wa -k shell-persistence
-w {{ real_user_home }}/.bashrc -p wa -k shell-persistence
-w {{ real_user_home }}/.local/bin/ -p wa -k user-persistence

# Audit infrastructure protection
-w /etc/audit/ -p wa -k audit-config
-w /usr/bin/auditd -p x -k audit-tools
-w /usr/bin/auditctl -p x -k audit-tools
-w /usr/bin/augenrules -p x -k audit-tools

# AIDE integrity monitoring protection (prevent covert tampering of AIDE baseline)
-w /var/lib/aide/ -p wa -k aide-integrity
-w /etc/aide.conf -p wa -k aide-integrity

# TLP battery/power configuration changes
-w /etc/tlp.d/ -p wa -k power-config
-w /etc/tlp.conf -p wa -k power-config

# USBGuard device whitelist (allow new devices to avoid silent privilege escalation)
-w /etc/usbguard/ -p wa -k device-policy

# Kernel parameter and module configuration
-w /etc/sysctl.d/ -p wa -k kernel-params
-w /etc/modprobe.d/ -p wa -k kernel-modules

# Privilege escalation syscalls (CIS benchmark)
-a always,exit -F arch=b64 -S setuid -S setreuid -S setresuid -k privilege-escalation
-a always,exit -F arch=b32 -S setuid -S setreuid -S setresuid -k privilege-escalation
-a always,exit -F arch=b64 -S setgid -S setregid -S setresgid -k privilege-escalation
-a always,exit -F arch=b32 -S setgid -S setregid -S setresgid -k privilege-escalation

# Kernel module loading (sign of rootkit installation or unauthorized driver)
-a always,exit -F arch=b64 -S init_module -S finit_module -k kernel-module-load
-a always,exit -F arch=b32 -S init_module -S finit_module -k kernel-module-load
-a always,exit -F arch=b64 -S delete_module -k kernel-module-unload
-a always,exit -F arch=b32 -S delete_module -k kernel-module-unload

# Process execution with setuid/setgid (privileged command audit)
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=-1 -k privileged-exec
-a always,exit -F arch=b32 -S execve -F euid=0 -F auid>=1000 -F auid!=-1 -k privileged-exec

# Date/time modification (CIS 4.1.x)
-a always,exit -F arch=b64 -S adjtimex -S settimeofday -k time-change
-a always,exit -F arch=b32 -S adjtimex -S settimeofday -k time-change
-a always,exit -F arch=b64 -S clock_settime -k time-change
-a always,exit -F arch=b32 -S clock_settime -k time-change
-w /etc/localtime -p wa -k time-change

# Unauthorized file access attempts (EACCES/EPERM) — CIS 4.1.x
-a always,exit -F arch=b64 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=-1 -k access
-a always,exit -F arch=b32 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=-1 -k access
-a always,exit -F arch=b64 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=-1 -k access
-a always,exit -F arch=b32 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=-1 -k access

# File deletion by users (CIS 4.1.x)
-a always,exit -F arch=b64 -S unlink -S unlinkat -S rename -S renameat -F auid>=1000 -F auid!=-1 -k delete
-a always,exit -F arch=b32 -S unlink -S unlinkat -S rename -S renameat -F auid>=1000 -F auid!=-1 -k delete

# Filesystem mounts (CIS 4.1.x)
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=-1 -k mounts
-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=-1 -k mounts

# Login/logout events (CIS 4.1.x)
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock -p wa -k logins

# Network environment changes (CIS 4.1.3.5)
-a always,exit -F arch=b64 -S sethostname -S setdomainname -k system-locale
-a always,exit -F arch=b32 -S sethostname -S setdomainname -k system-locale
-w /etc/hosts -p wa -k system-locale
-w /etc/hostname -p wa -k system-locale
-w /etc/sysconfig/network -p wa -k system-locale

# DAC permission modification (CIS 4.1.3.9)
-a always,exit -F arch=b64 -S chmod -S fchmod -S fchmodat -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b32 -S chmod -S fchmod -S fchmodat -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S chown -S fchown -S fchownat -S lchown -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b32 -S chown -S fchown -S fchownat -S lchown -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b32 -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F auid>=1000 -F auid!=-1 -k perm_mod

# MAC (SELinux) policy changes (CIS 4.1.3.14)
-a always,exit -F path=/usr/sbin/semanage -F perm=x -F auid>=1000 -F auid!=-1 -k MAC-policy
-a always,exit -F path=/usr/sbin/setsebool -F perm=x -F auid>=1000 -F auid!=-1 -k MAC-policy
-a always,exit -F path=/usr/bin/chcon -F perm=x -F auid>=1000 -F auid!=-1 -k MAC-policy
-a always,exit -F path=/usr/sbin/setfiles -F perm=x -F auid>=1000 -F auid!=-1 -k MAC-policy

# sudo log watch (CIS 4.1.3.3)
-w /var/log/sudo.log -p wa -k actions

# Make rules immutable until next reboot.
# WARNING: after first deployment, manual augenrules --load or auditctl -R
# will silently fail (EPERM) without a full service restart. Use 'make system'
# which triggers the auditd handler that does a complete stop+start cycle.
-e 2
