# {{ ansible_managed }}
[Unit]
Description=AIDE failure notification for %i
After=network.target

[Service]
Type=oneshot
# Write to the system wall so it surfaces on all TTYs at next interactive login.
ExecStart=/usr/bin/wall "AIDE ALERT: File integrity violations detected. Run: systemctl status %i"
# Also log a prominent journal entry so it appears in 'journalctl -p warning'.
ExecStart=/usr/bin/logger -p auth.warning -t aide-notify "AIDE file integrity violations detected — check: systemctl status %i or /var/log/aide/aide.log"
