# {{ ansible_managed }}
# Blacklist unused filesystem and DMA modules (CIS/STIG)

# Unused filesystems — attack surface via crafted images
# squashfs is NOT blacklisted — Flatpak runtime images require it. Without it
# all Flatpak app launches fail. CIS 1.1.1.6 calls for squashfs; this is the
# intentional exception matching the SCTP pattern in the network section below.
blacklist cramfs
install cramfs /bin/false
blacklist freevxfs
install freevxfs /bin/false
blacklist jffs2
install jffs2 /bin/false
blacklist hfs
install hfs /bin/false
blacklist hfsplus
install hfsplus /bin/false
blacklist udf
install udf /bin/false

# Unused network protocols — CVE-validated attack surface
# Note: sctp is NOT blacklisted — OVN-Kubernetes kind cluster tests and
# Submariner use SCTP; 'install sctp /bin/false' would silently break them.
blacklist dccp
install dccp /bin/false
blacklist rds
install rds /bin/false
blacklist tipc
install tipc /bin/false

# DMA attack interfaces — physical access exploitation
blacklist firewire-core
install firewire-core /bin/false
blacklist firewire-ohci
install firewire-ohci /bin/false
blacklist firewire-sbp2
install firewire-sbp2 /bin/false

{% if system_disable_usb_storage | bool %}
# USB mass storage: kernel-blocked (system_disable_usb_storage=true in config.yml).
# USBGuard cannot override kernel-level blocking — USB drives will not mount even with USBGuard rules.
# Set system_disable_usb_storage: false in config.yml to allow USB storage.
# Recovery without re-provisioning: sudo modprobe usb_storage && sudo modprobe uas
blacklist usb_storage
install usb_storage /bin/false
blacklist uas
install uas /bin/false
{% endif %}

# vivid: virtual video test driver — CVE history (OOB write, privilege escalation),
# ships in every Fedora kernel, no legitimate use on workstations.
blacklist vivid
install vivid /bin/false

# n_hdlc: TTY HDLC line discipline — CVE history (privilege escalation),
# CIS RHEL 9 Level 2 recommended blacklist, no legitimate workstation use.
blacklist n_hdlc
install n_hdlc /bin/false

{% if system_disable_bluetooth | bool %}
# Bluetooth stack disabled — system_disable_bluetooth=true in config.yml.
# CIS RHEL 9 2.1.5: blacklist BT modules on machines with no BT peripherals.
# Default is false (enabled) — required for Bluetooth peripherals (e.g. ThinkPad P16v AMD BT mouse).
blacklist btusb
install btusb /bin/false
blacklist bluetooth
install bluetooth /bin/false
{% endif %}
