[Unit]
Description=Prune stopped containers and dangling images

[Service]
Type=oneshot
# label filter protects stopped distrobox containers; distrobox images are safe
# because they are tagged (not dangling) — podman system prune without --all
# skips non-dangling images regardless of the label filter
ExecStart=/usr/bin/podman system prune --force --filter label!=manager=distrobox

# Seccomp-only hardening; no NoNewPrivileges (newuidmap needs its file capabilities when
# no rootless pause process exists yet). Namespacing options (PrivateTmp, ProtectSystem, ProtectHostname,
# ProtectClock) make the user manager run the unit in its own user namespace, and rootless
# podman then cannot join its existing one ("cannot re-exec process to join the existing
# user namespace"), so every prune failed.
LockPersonality=true
RestrictRealtime=true
# podman communicates over Unix sockets only (no network needed for prune)
RestrictAddressFamilies=AF_UNIX
