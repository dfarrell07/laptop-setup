# Seeded by laptop-setup. User edits are preserved, except approval_policy and sandbox_mode (reapplied each run).
approval_policy = {{ codex_approval_policy | to_json }}
sandbox_mode = {{ codex_sandbox_mode | to_json }}
model = {{ (codex_work_model if item == codex_work_config_dir else codex_personal_model) | to_json(ensure_ascii=False) }}
model_reasoning_effort = {{ (codex_work_reasoning_effort if item == codex_work_config_dir else codex_personal_reasoning_effort) | to_json }}
