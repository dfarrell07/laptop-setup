{
  "env": {
{% for key, value in claude_telemetry_env.items() %}
    {{ key | to_json }}: {{ value | to_json }}{{ "," if not loop.last else "" }}
{% endfor %}
  },
  "sandbox": {{ dict(claude_sandbox_config, enableWeakerNestedSandbox=(claude_nested_sandbox | bool)) | to_json }},
  "enableAllProjectMcpServers": {{ claude_enable_all_project_mcp_servers | to_json }},
  "permissions": {
    "deny": [
{% set deny_entries = [] %}
{# Isolate the other instances entirely; this instance keeps access to its own memory and plans. #}
{% for instance_dir in _claude_instances if instance_dir != item %}
{% set _path = (instance_dir | replace(ansible_facts['user_dir'], '~')) + '/**' %}
{% set _ = deny_entries.append("Read(" + _path + ")") %}
{% set _ = deny_entries.append("Edit(" + _path + ")") %}
{% endfor %}
{% set _own = item | replace(ansible_facts['user_dir'], '~') %}
{% for name in claude_own_instance_deny_read %}
{% set _ = deny_entries.append("Read(" + _own + "/" + name + ")") %}
{% endfor %}
{% for name in claude_own_instance_deny_write %}
{% set _ = deny_entries.append("Edit(" + _own + "/" + name + ")") %}
{% endfor %}
{% for path in claude_deny_sensitive %}
{% set _ = deny_entries.append("Read(" + path + ")") %}
{% set _ = deny_entries.append("Edit(" + path + ")") %}
{% endfor %}
{% for path in claude_deny_write_only %}
{% set _ = deny_entries.append("Edit(" + path + ")") %}
{% endfor %}
{% for entry in deny_entries %}
      {{ entry | to_json }}{{ "," if not loop.last else "" }}
{% endfor %}
    ]
  }
}
