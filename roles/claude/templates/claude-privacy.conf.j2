# Keep the default instance and its children private at boot.
# The recursive mask removes group/other access without making ordinary files executable.
# Existing executable files and directories retain owner execute permission.
d %h/.claude 0700 - - -
Z %h/.claude ~0700 - - -
z %h/.claude/settings.json 0600 - - -
{% for inst in _claude_instances if inst != claude_default_config_dir %}
d {{ inst }} 0700 - - -
Z {{ inst }} ~0700 - - -
z {{ inst }}/settings.json 0600 - - -
{% endfor %}
