#!/bin/bash
# {{ ansible_managed }}
# agent-getty: keep one harness/profile pair's remote-control daemon running in detached tmux, so new agent sessions
# can be started on this machine from the phone or web. Docs: docs/agent-getty.md in laptop-setup.
#   agent-getty run <pair>      what the service manager runs: start the pair's tmux session unless it is running,
#                               then wait while it lives; exit 1 when it ends, so the service manager restarts it
#   agent-getty attach <pair>   attach to the pair's daemon (detach: C-b d)
#   agent-getty ls              each enabled pair and whether it runs
# Pairs: claude-personal, claude-personal2, codex-work, codex-personal. Each has its own tmux server
# (tmux -L agent-getty-<pair>), so a stop or a crash takes down that pair only. bash 3.2 compatible (macOS).
set -u

ENABLED={{ _getty_enabled | join(' ') | quote }}
DIR={{ agent_getty_dir | quote }}
HOST={{ agent_getty_host | quote }}
CODEX_WORK={{ codex_work_config_dir | quote }}
CODEX_PERSONAL={{ codex_personal_config_dir | quote }}
CLAUDE_PERSONAL={{ claude_default_config_dir | quote }}
CLAUDE_PERSONAL2={{ claude_personal2_config_dir | quote }}
MODE={{ claude_default_mode | quote }}
POLL=${AGENT_GETTY_POLL:-15}
# The daemon's own output (e.g. "not logged in"), kept after its pane is gone
case $(uname -s) in Darwin) LOGDIR=$HOME/Library/Logs ;; *) LOGDIR=${XDG_STATE_HOME:-$HOME/.local/state}/agent-getty ;; esac
umask 077 # the logs can hold session URLs
TMUX_BIN=${AGENT_GETTY_TMUX:-tmux}

die() { echo "agent-getty: $1" >&2; exit "${2:-1}"; }
t() { env -u TMUX "$TMUX_BIN" -L "agent-getty-$PAIR" -f /dev/null "$@"; }
alive() { t has-session -t "=getty-$PAIR" 2>/dev/null; }

# The pair's daemon, with only that profile's account (the variables mirror cper, cper2, owork and oper in zshrc.j2).
command_for() {
	local -a vertex=(-u CLAUDE_CODE_USE_VERTEX -u ANTHROPIC_VERTEX_PROJECT_ID -u CLOUD_ML_REGION
		-u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_PROJECT -u ANTHROPIC_BASE_URL -u ANTHROPIC_API_KEY
		-u ANTHROPIC_AUTH_TOKEN -u CLAUDE_CODE_OAUTH_TOKEN -u CLAUDE_CODE_USE_BEDROCK -u CLAUDE_CODE_USE_FOUNDRY)
	local -a openai=(-u OPENAI_API_KEY -u CODEX_API_KEY -u OPENAI_BASE_URL -u OPENAI_ORG_ID -u OPENAI_PROJECT_ID)
	case $1 in
	# Each harness also drops the other's account variables: a daemon holds only its own profile's credentials.
	claude-personal) CMD=(env "${vertex[@]}" "${openai[@]}" CLAUDE_CODE_USE_VERTEX=0 "CLAUDE_CONFIG_DIR=$CLAUDE_PERSONAL") ;;
	claude-personal2) CMD=(env "${vertex[@]}" "${openai[@]}" CLAUDE_CODE_USE_VERTEX=0 "CLAUDE_CONFIG_DIR=$CLAUDE_PERSONAL2") ;;
	codex-work) CMD=(env "${vertex[@]}" "CODEX_HOME=$CODEX_WORK" codex remote-control --no-daemon); return ;;
	codex-personal)
		mkdir -p "$CODEX_PERSONAL" && chmod 700 "$CODEX_PERSONAL" || die "cannot create $CODEX_PERSONAL"
		CMD=(env "${vertex[@]}" "${openai[@]}" "CODEX_HOME=$CODEX_PERSONAL" codex remote-control --no-daemon); return ;;
	*) die "unknown pair '$1' (claude-personal, claude-personal2, codex-work, codex-personal)" 2 ;;
	esac
	# Sessions started from the phone run in the mode the shell launchers' sessions do (claude_default_mode).
	CMD+=(claude remote-control --name "$HOST-$1" --permission-mode "$MODE")
}

# Claude asks whether to trust the folder it starts sessions in; agent_getty_dir is the owner's choice of folder, so the
# prompt naming exactly it is answered. Claude ignores an answer that comes too soon after the question and asks again
# (redrawn in place), so the question is answered whenever it is on screen, a moment after it appeared and at least 3 s
# after the last answer, at most 3 times. Any other prompt is left for the owner (agent-getty attach).
answer_trust() {
	local n=0 seen='' last=-100 answers=0 question="Trust $DIR? [y/N]"
	while [ "$n" -lt 45 ] && [ "$answers" -lt 3 ]; do
		alive || return
		if t capture-pane -p -t "=getty-$PAIR:" 2>/dev/null | grep -qxF "$question"; then
			[ -n "$seen" ] || seen=$SECONDS
			if [ $((SECONDS - seen)) -ge 1 ] && [ $((SECONDS - last)) -ge 3 ]; then
				t send-keys -t "=getty-$PAIR:" y Enter
				last=$SECONDS
				answers=$((answers + 1))
			fi
		elif [ "$answers" -gt 0 ]; then
			return # answered, and the question is gone
		fi
		sleep 1
		n=$((n + 1))
	done
}

# Stopping the service stops the daemon too: tmux built with systemd support moves each pane into its own scope, outside
# the unit's cgroup, and launchd's bootout misses the tmux server (setsid). The pane's process group and the server go.
stop() {
	local pid
	pid=$(t display-message -p -t "=getty-$PAIR:" '#{pane_pid}' 2>/dev/null) && kill -TERM -- "-$pid" 2>/dev/null
	t kill-server 2>/dev/null
	exit 0
}

run() {
	PAIR=$1
	command_for "$PAIR"
	trap stop TERM INT HUP # before starting: a stop during start-up must not leave the daemon behind
	if ! alive; then
		t kill-server 2>/dev/null # a server whose session died: start clean
		mkdir -p "$LOGDIR"
		# The pane waits for one Enter, sent once its output is piped to the log, so even a daemon that prints one
		# error and exits at once leaves it in the log
		t new-session -d -s "getty-$PAIR" -x 200 -y 50 -c "$DIR" -- sh -c 'read -r _; exec "$@"' sh "${CMD[@]}" ||
			die "could not start getty-$PAIR"
		t pipe-pane -o -t "=getty-$PAIR:" "cat >> $(printf %q "$LOGDIR/agent-getty-$PAIR-daemon.log")"
		t send-keys -t "=getty-$PAIR:" Enter
		case $PAIR in claude-*) answer_trust ;; esac
	fi
	while alive; do
		sleep "$POLL" &
		wait $! # so a stop signal is handled at once, not after the sleep
	done
	die "getty-$PAIR ended"
}

case ${1:-} in
run) [ $# = 2 ] || die "usage: agent-getty run <pair>" 2; run "$2" ;;
attach) [ $# = 2 ] || die "usage: agent-getty attach <pair>" 2; PAIR=$2; command_for "$PAIR"; t attach -t "=getty-$PAIR" ;;
ls)
	for PAIR in $ENABLED; do
		if alive; then echo "$PAIR running"; else echo "$PAIR stopped"; fi
	done ;;
*) die "usage: agent-getty run|attach <pair> | ls" 2 ;;
esac
