<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{ ansible_managed }} -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.{{ dotfiles_github_user }}.claude-queue</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ ansible_facts['user_dir'] }}/.local/bin/claude-queue-poller.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>{{ claude_queue_poll_interval_sec }}</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{ ansible_facts['user_dir'] }}</string>
    <key>PATH</key>
    <string>{{ ansible_facts['user_dir'] }}/.local/bin:{{ dotfiles_homebrew_prefix }}/bin:{{ dotfiles_homebrew_prefix }}/opt/util-linux/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CLAUDE_QUEUE_REPO</key>
    <string>{{ claude_queue_repo }}</string>
    <key>CLAUDE_BIN</key>
    <string>{{ ansible_facts['user_dir'] }}/.local/bin/claude</string>
    <key>CLAUDE_CONFIG_DIR</key>
    <string>{{ claude_queue_config_dir }}</string>
    <key>CLAUDE_QUEUE_MAX_TURNS</key>
    <string>{{ claude_queue_max_turns }}</string>
    <key>CLAUDE_QUEUE_TIMEOUT</key>
    <string>{{ claude_queue_timeout }}</string>
    <key>CLAUDE_QUEUE_HOST_LABEL</key>
    <string>{{ claude_queue_host_label }}</string>
  </dict>
  <key>StandardOutPath</key>
  <string>{{ claude_queue_log_dir_macos }}/claude-queue.log</string>
  <key>StandardErrorPath</key>
  <string>{{ claude_queue_log_dir_macos }}/claude-queue.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
