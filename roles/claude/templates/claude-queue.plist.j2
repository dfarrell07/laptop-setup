<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{ ansible_managed }} -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.{{ dotfiles_github_user | e }}.claude-queue</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ claude_queue_poller_path | e }}</string>
  </array>
  <key>StartInterval</key>
  <integer>{{ claude_queue_poll_interval_sec | int }}</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{ ansible_facts['user_dir'] }}</string>
    <key>PATH</key>
    <string>{{ ansible_facts['user_dir'] }}/.local/bin:{{ dotfiles_homebrew_prefix | e }}/bin:{{ dotfiles_homebrew_prefix | e }}/opt/util-linux/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CLAUDE_QUEUE_REPO</key>
    <string>{{ claude_queue_repo | e }}</string>
    <key>CLAUDE_BIN</key>
    <string>{{ claude_bin_path | e }}</string>
    <key>CLAUDE_CONFIG_DIR</key>
    <string>{{ claude_queue_config_dir | e }}</string>
    <key>CLAUDE_QUEUE_MAX_TURNS</key>
    <string>{{ claude_queue_max_turns | int }}</string>
    <key>CLAUDE_QUEUE_TIMEOUT</key>
    <string>{{ claude_queue_timeout | int }}</string>
    <key>CLAUDE_QUEUE_HOST_LABEL</key>
    <string>{{ claude_queue_host_label | e }}</string>
  </dict>
  <key>StandardOutPath</key>
  <string>{{ claude_log_dir | e }}/claude-queue.log</string>
  <key>StandardErrorPath</key>
  <string>{{ claude_log_dir | e }}/claude-queue.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
