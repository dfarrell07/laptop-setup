# {{ ansible_managed }}
# agent-getty for one harness/profile pair (the instance, e.g. claude-personal): its remote-control daemon in detached
# tmux. Docs: docs/agent-getty.md. Attach: agent-getty attach %i
[Unit]
Description=agent-getty %i (agent-getty attach %i)
# Never give up: a daemon that cannot log in yet retries every 30 s, like launchd's ThrottleInterval on macOS. A growing
# delay (RestartSteps) is not used: systemd resets it only on a manual start, so after a few crashes every later
# recovery would wait the maximum.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash %h/.local/bin/agent-getty run %i
Restart=always
RestartSec=30
# The default KillMode (control-group) signals every process in the unit; the script's stop trap also ends the daemon,
# which tmux built with systemd support moves to a scope of its own.
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# The shells' tmux socket directory (zshrc.j2), so agent-getty attach and ls from a shell find the daemon
Environment=TMUX_TMPDIR=%t/tmux
ExecStartPre=/usr/bin/mkdir -p -m 0700 %t/tmux

[Install]
WantedBy=default.target
