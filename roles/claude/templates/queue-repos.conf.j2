# ~/.config/claude/queue-repos.conf
# Repo map for claude-queue-poller.sh (deployed by Ansible; edit to add your repos).
#
# Each key is the short name used in GitHub issue bodies:
#   repo: <key>
#
# Format (one block per repo — parsed as key=value, not executed):
#   REPO_PATH[key]="/absolute/path/to/local/clone"
#   REPO_REMOTE[key]="github-owner/repo-name"
#   REPO_ALLOWED_TOOLS[key]="Read(./**),Edit(./**)"
#   REPO_DEFAULT_BRANCH[key]="main"
#
# REPO_ALLOWED_TOOLS and REPO_DEFAULT_BRANCH are optional (default branch: main).
# Keep comments on their own lines; trailing comments are stripped but avoid them.
# Claude works in a throwaway worktree of the clone; the poller itself fetches, commits
# (without hooks, then scans with gitleaks), pushes from the clone and opens the PR.
#
# REPO_ALLOWED_TOOLS controls what Claude Code may call; the default is Read(./**),Edit(./**).
# The poller runs an issue only when every entry is Read, Edit, Write or NotebookEdit under
# ./ (the worktree; bare, they reach any file not denied), Grep, Glob, or, in a list with
# no Edit or Write, Bash with one exact command (no wildcard, quote, backslash, $ or
# backtick, and no git). Beside Edit, any command can run what the agent wrote: a
# Makefile, a script, even a submodule's config that git status reads.
#
# Task queue repo: {{ claude_queue_repo if claude_queue_repo else '<set claude_queue_repo in config.yml>' }}
# GitHub user:     {{ dotfiles_github_user }}
#
# Example — uncomment and adjust:
#
# REPO_PATH[laptop-setup]="{{ ansible_facts['user_dir'] }}/laptop-setup"
# REPO_REMOTE[laptop-setup]="{{ dotfiles_github_user }}/laptop-setup"
# REPO_ALLOWED_TOOLS[laptop-setup]="Read(./**),Edit(./**)"
# REPO_DEFAULT_BRANCH[laptop-setup]="main"
#
# REPO_PATH[my-project]="{{ ansible_facts['user_dir'] }}/repos/my-project"
# REPO_REMOTE[my-project]="{{ dotfiles_github_user }}/my-project"
# REPO_ALLOWED_TOOLS[my-project]="Read(./**) Bash(make lint)"
# REPO_DEFAULT_BRANCH[my-project]="main"
