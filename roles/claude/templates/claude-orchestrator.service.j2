# {{ ansible_managed }}
# The claude-skills session orchestrator at boot. Design: claude-skills plans/session-orchestrator.md, "Boot".
{% set checkout = claude_orchestrator_checkout | regex_replace('[\r\n].*', '') %}
{% set launcher = checkout ~ '/skills/sessions/scripts/session.sh' %}
{% set name = claude_orchestrator_name | regex_replace('[^A-Za-z0-9_-]', '') %}
[Unit]
Description=Claude session orchestrator (tmux attach -t personal-{{ name }})
After=network-online.target

[Service]
Type=oneshot
# tmux, and every session in it, outlives the unit; rerunning the unit is harmless
KillMode=process
TimeoutStartSec=300
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The shells' tmux socket directory (zshrc.j2), so tmux attach and the launcher's ls find these sessions
Environment=TMUX_TMPDIR=%t/tmux
ExecStartPre=-/usr/bin/nm-online -q -t 120
ExecStartPre=/usr/bin/mkdir -p -m 0700 %t/tmux
# Forget the last boot's definition: each boot starts a fresh conversation
ExecStartPre=-/bin/bash {{ launcher }} clean personal-{{ name }}
ExecStart=/bin/bash {{ launcher }} start personal {{ checkout }} --here --name {{ name }} --trust --prompt /claude-skills:sessions --allow "Bash(bash {{ launcher }} *) Skill(claude-skills:sessions)"

[Install]
WantedBy=default.target
