# {{ ansible_managed }}
[Unit]
Description=Claude Code Task Queue Poller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStopSec={{ claude_queue_timeout | int + 300 }}
ExecStart={{ ansible_facts['user_dir'] }}/.local/bin/claude-queue-poller.sh
Environment=CLAUDE_QUEUE_REPO={{ claude_queue_repo }}
Environment=CLAUDE_BIN={{ ansible_facts['user_dir'] }}/.local/bin/claude
Environment=CLAUDE_QUEUE_MAX_TURNS={{ claude_queue_max_turns }}
Environment=CLAUDE_QUEUE_TIMEOUT={{ claude_queue_timeout }}
Environment=CLAUDE_QUEUE_HOST_LABEL={{ claude_queue_host_label | default('') }}
Environment=CLAUDE_CONFIG_DIR={{ claude_work_config_dir }}
UnsetEnvironment=ANTHROPIC_BASE_URL HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
MemoryMax={{ claude_queue_memory_max }}
CPUQuota={{ claude_queue_cpu_quota }}
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
RestrictSUIDSGID=true
ProcSubset=pid
SystemCallArchitectures=native
ProtectKernelLogs=true
UMask=0077
