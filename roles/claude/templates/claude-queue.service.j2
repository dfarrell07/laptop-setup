# {{ ansible_managed }}
[Unit]
Description=Claude Code Task Queue Poller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStopSec={{ claude_queue_timeout | int + 300 }}
TimeoutStartSec={{ (claude_queue_max_issues_per_run | int) * (claude_queue_timeout | int) + 300 }}
ExecStart={{ claude_queue_poller_path | regex_replace('[\r\n].*', '') }}
Environment=CLAUDE_QUEUE_REPO={{ claude_queue_repo | regex_replace('[\r\n].*', '') }}
Environment=CLAUDE_BIN={{ claude_bin_path }}
Environment=CLAUDE_QUEUE_MAX_TURNS={{ claude_queue_max_turns | int }}
Environment=CLAUDE_QUEUE_TIMEOUT={{ claude_queue_timeout | int }}
Environment=CLAUDE_QUEUE_MAX_ISSUES_PER_RUN={{ claude_queue_max_issues_per_run | int }}
Environment="CLAUDE_QUEUE_HOST_LABEL={{ claude_queue_host_label | regex_replace('[\r\n].*', '') }}"
Environment=CLAUDE_CONFIG_DIR={{ claude_queue_config_dir | regex_replace('[\r\n].*', '') }}
Environment=CLAUDE_QUEUE_LOG_DIR={{ claude_log_dir }}
Environment=CLAUDE_QUEUE_ALLOWED_AUTHORS={{ claude_queue_allowed_authors | map('regex_replace', '[\r\n,=].*', '') | join(',') }}
UnsetEnvironment=ANTHROPIC_BASE_URL HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
MemoryMax={{ claude_queue_memory_max | regex_replace('[\r\n].*', '') }}
CPUQuota={{ claude_queue_cpu_quota | regex_replace('[\r\n].*', '') }}
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=full
InaccessiblePaths=/run/user/%U/podman
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
ProtectClock=true
PrivateDevices=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# Claude Code's sandbox runs bubblewrap, which needs user namespaces and mount syscalls, and
# cannot mount a fresh /proc when systemd has masked paths under it. So: no RestrictNamespaces,
# ProtectKernelTunables, ProtectKernelLogs or ProtectHostname, and @mount is allowed. Verified
# with systemd-run --user and bwrap --unshare-all --proc /proc.
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
UMask=0077
MemoryDenyWriteExecute=true
