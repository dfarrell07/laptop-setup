---
extends: default

ignore: |
  collections/
  node_modules/
  .venv/

rules:
  line-length:
    max: 140
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true  # require string form "0644" not 0o644 — Ansible convention
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
