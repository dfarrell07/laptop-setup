# User overrides — may contain sensitive values (per-machine)
/config.yml

# Vault password files
.vault_pass*
scripts/vault-pass.sh
scripts/vault-pass.sh.sha256

# Private key / credential files that must never be committed
*.pem
*.key
*.p12
*.pfx
id_ed25519*
id_rsa*
id_ecdsa*
.env
.netrc
.git-credentials
*.kubeconfig
*.jks
*.ppk
*.p8
*.age

# GnuPG homedir — contains private keys; never commit
/gpg/

# Installed collections
collections/

# Ansible temp files
*.retry
temp

# CSB report output
csb-report.md

# Claude Code worktrees and local state
.claude/worktrees/
.claude/projects/
.claude/file-history/
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/settings.local.json
CLAUDE.local.md

# Ansible runtime
.ansible/
galaxy_cache/
/tmp/

# Python venv (hash-pinned lockfile requirements-test.lock is tracked; regenerate with `make pip-lock`)
.venv/

# Node.js
node_modules/

# Python bytecode
__pycache__/
*.pyc

# Molecule runtime state
.molecule/

# Downloaded RPM packages
*.rpm

# RPM build/packaging artifacts (tarballs, specs, patches, keys, sysusers and pam files)
# Root-anchored (/foo) to avoid shadowing tracked files in subdirectories.
/*.patch
/*.gpg
/*.tar.gz
/*.tar.gz.asc
/*.spec
/*.sysusers
/*.pam
/*.sysconfig
/openssh-server-systemd-sysusers.conf
/parallel_test.*
/ssh-agent.*
/ssh-host-keys-migration.*
/sshd*

# Stray system directories (AIDE/package artifacts)
/etc/
/usr/
/var/

# Version-string files at repo root (binary download debugging artifacts)
/[0-9]*.[0-9]*.[0-9]*

# Stray test script at repo root
/hello.sh
/group_vars/all/local_repos.yml
